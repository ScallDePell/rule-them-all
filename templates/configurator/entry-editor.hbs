        </fieldset>
        {{#if hasLegacyAcquisitions}}
        <details class="rta-config-entry__section" open><summary><strong>{{localize "RTA.Template.DefinitionsGranted"}}</strong><span class="rta-config-entry__section-summary">{{definitionSummary}}</span></summary><div class="rta-config-entry__section-heading"><p>{{localize "RTA.Template.SelectTheDefinitionsGrantedByThisContentOptionalInitialRuntimeValuesAreAppliedOnlyWhenTheAcquisitionCreatesTheDefinitionState"}}</p></div><div class="rta-binding-list">{{#each definitionBindingRows}}<article class="rta-binding-card" data-definition-binding="{{id}}" data-rta-colors="{{colors}}"><label class="rta-binding-card__title"><input type="checkbox" name="templateDefinitionRefs" value="{{id}}" {{#if selected}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> <strong>{{label}}</strong></label><div class="rta-binding-card__values">{{#if hasValue}}<label>{{localize "RTA.Template.InitialValue"}}<input type="number" data-binding-slot="value.base" value="{{valueBase}}" {{#if ../readOnly}}readonly{{/if}}></label>{{/if}}{{#each poolSlots}}<label>{{localize "RTA.Slots.Initial"}} · {{id}}<input type="number" data-binding-slot="{{key}}" value="{{value}}" {{#if @root.readOnly}}readonly{{/if}}></label>{{/each}}{{#if hasState}}<label class="rta-field-editor__check"><input type="checkbox" data-binding-slot="state.active" {{#if stateActive}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{localize "RTA.Template.InitiallyActive"}}</label>{{/if}}</div></article>{{else}}<p>{{localize "RTA.Template.NoDefinitionsAvailable"}}</p>{{/each}}</div></details>
        {{/if}}
        <details class="rta-config-entry__section" open><summary><strong>{{localize "RTA.Template.AcquisitionChoices"}}</strong><span class="rta-config-entry__section-summary">{{choiceGroupRows.length}} {{localize "RTA.Template.GroupsCount"}}</span></summary><div class="rta-config-entry__section-heading"><p>{{localize "RTA.Relations.ChoicesExplanation"}}</p><button type="button" data-action="addChoiceGroup" {{#if readOnly}}disabled{{/if}}><i class="fa-solid fa-plus"></i> {{localize "RTA.Template.AddChoice"}}</button></div><div data-choice-group-list>{{#each choiceGroupRows}}<article class="rta-binding-card" data-choice-group="{{id}}" data-choice-initial-operation="{{operation}}"><div class="rta-config-entry__section-heading"><strong>{{name}}</strong><button type="button" class="rta-config-action" data-action="removeChoiceGroup" title="{{localize 'RTA.Template.RemoveChoice'}}" aria-label="{{localize 'RTA.Template.RemoveChoice'}}" {{#if ../readOnly}}disabled{{/if}}><i class="fa-solid fa-trash"></i></button></div><div class="rta-field-editor__grid"><label>{{localize "RTA.Template.Name"}}<input data-choice-prop="name" value="{{name}}" required {{#if ../readOnly}}readonly{{/if}}></label><label>{{localize "RTA.Template.Minimum"}}<input type="number" min="0" data-choice-prop="min" value="{{min}}" {{#if ../readOnly}}readonly{{/if}}></label><label>{{localize "RTA.Template.Maximum"}}<input type="number" min="0" data-choice-prop="max" value="{{max}}" {{#if ../readOnly}}readonly{{/if}}></label></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Relations.Operation"}}</label><select data-choice-prop="operation" {{#if ../readOnly}}disabled{{/if}}><option value="link" data-rta-colors="#666666" {{#if isLink}}selected{{/if}}>{{localize "RTA.Relations.Link"}}</option><option value="unlock" data-rta-colors="#666666" {{#if isUnlock}}selected{{/if}}>{{localize "RTA.Relations.Unlock"}}</option><option value="grant" data-rta-colors="#666666" {{#if isGrant}}selected{{/if}}>{{localize "RTA.Relations.Grant"}}</option></select></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Relations.Target"}}</label><details class="rta-picker rta-config-entry__section" data-picker><summary><strong>{{localize "RTA.Relations.Target"}}</strong></summary><div class="rta-picker__body rta-choice-list">{{> rtaPickerSearch placeholder=(localize "RTA.Relations.Search")}}{{#each targetOptions}}<label data-picker-option data-picker-label="{{label}}" data-rta-colors="{{colors}}"><input type="checkbox" name="choiceTargetRef" value="{{id}}" {{#if selected}}checked{{/if}} {{#if ../../readOnly}}disabled{{/if}}> {{label}}</label>{{else}}<p>{{localize "RTA.Relations.NoTargets"}}</p>{{/each}}</div></details></div></article>{{else}}<p>{{localize "RTA.Template.NoAcquisitionChoicesThisContentIsAppliedDirectly"}}</p>{{/each}}</div></details>
        {{#if hasLegacyAcquisitions}}
        <details class="rta-picker rta-config-entry__section" data-picker><summary><strong>{{localize "RTA.Template.ActionsGranted"}}</strong><span data-picker-summary>{{templateActionSummary}}</span></summary><div class="rta-picker__body rta-choice-list">{{> rtaPickerSearch placeholder=(localize "RTA.Template.SearchActions")}}{{#each templateActionChoices}}<label data-picker-option data-picker-label="{{label}}" data-rta-colors="{{colors}}"><input type="checkbox" name="templateActionRefs" value="{{id}}" {{#if selected}}checked{{/if}}> {{label}}</label>{{else}}<p>{{localize "RTA.Template.NoActionsAvailable"}}</p>{{/each}}</div></details>
        {{/if}}
        {{> rtaCategoriesPicker}}
        {{> rtaTagsPicker}}
        {{#unless creating}}<details class="rta-config-entry__section rta-config-entry__technical"><summary>{{localize "RTA.Template.Technical"}}</summary><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Id"}}</label><input value="{{data.id}}" readonly></div><details><summary>{{localize "RTA.Template.RawFieldData"}}</summary><textarea rows="8" readonly>{{dataJson}}</textarea></details></details>{{/unless}}
      {{/if}}

      {{#if isSheetDefinition}}
        <fieldset class="rta-sheet-builder"><legend>{{localize "RTA.Template.Sheet"}}</legend>
          <div class="rta-field-editor__grid"><label>{{localize "RTA.Template.Name"}}<input name="nameKey" value="{{data.nameKey}}" required {{#if readOnly}}readonly{{/if}}></label><label>{{localize "RTA.Template.View"}}<select name="viewType" {{#if readOnly}}disabled{{/if}}><option value="actor" {{#if sheetViewActor}}selected{{/if}}>{{localize "RTA.Template.Actor"}}</option><option value="item" {{#if sheetViewItem}}selected{{/if}}>{{localize "RTA.Template.Item"}}</option><option value="content" {{#if sheetViewContent}}selected{{/if}}>{{localize "RTA.Template.Content"}}</option><option value="runtime" {{#if sheetViewRuntime}}selected{{/if}}>{{localize "RTA.Template.Runtime"}}</option></select></label><label>{{localize "RTA.Template.Layout"}}<select name="layoutDirection" {{#if readOnly}}disabled{{/if}}><option value="column">{{localize "RTA.Template.Column"}}</option><option value="grid">{{localize "RTA.Template.Grid"}}</option></select></label><label class="rta-field-editor__check"><input type="checkbox" name="enabled" {{#if data.enabled}}checked{{/if}} {{#if readOnly}}disabled{{/if}}> {{localize "RTA.Template.Enabled"}}</label></div>
          <label>{{localize "RTA.Template.Description"}}<textarea name="descriptionKey" rows="2" {{#if readOnly}}readonly{{/if}}>{{data.descriptionKey}}</textarea></label>
          <div class="rta-sheet-builder__head"><div><strong>{{localize "RTA.Template.WysiwygLayout"}}</strong><p>{{localize "RTA.Template.ConstrainedVisualCompositionComponentsReferenceConfiguredRulesetObjectsNoHtmlCssOrJavascriptIsStored"}}</p></div>{{#unless readOnly}}<button type="button" data-action="addSheetComponent"><i class="fa-solid fa-plus"></i> {{localize "RTA.Template.AddComponent"}}</button>{{/unless}}</div>
          <div class="rta-sheet-builder__canvas" data-sheet-components>
          {{#each sheetComponentRows}}<article class="rta-sheet-component" data-sheet-component data-component-id="{{id}}"><div class="rta-sheet-component__toolbar"><select data-sheet-prop="kind" {{#if ../readOnly}}disabled{{/if}}><option value="section" {{#if isSection}}selected{{/if}}>{{localize "RTA.Template.Section"}}</option><option value="text" {{#if isText}}selected{{/if}}>{{localize "RTA.Template.Text"}}</option><option value="field" {{#if isField}}selected{{/if}}>{{localize "RTA.Template.Field"}}</option><option value="repeater" {{#if isRepeater}}selected{{/if}}>{{localize "RTA.Template.Repeater"}}</option><option value="actions" {{#if isActions}}selected{{/if}}>{{localize "RTA.Template.Actions"}}</option><option value="content" {{#if isContent}}selected{{/if}}>{{localize "RTA.Template.Content"}}</option><option value="spacer" {{#if isSpacer}}selected{{/if}}>{{localize "RTA.Template.Spacer"}}</option></select><input data-sheet-prop="label" value="{{label}}" placeholder="{{localize 'RTA.Template.Label'}}" {{#if ../readOnly}}readonly{{/if}}>{{#unless ../readOnly}}<button type="button" class="rta-config-action" data-action="sheetUp" title="{{localize 'RTA.Template.MoveUp'}}" aria-label="{{localize 'RTA.Template.MoveUp'}}">↑</button><button type="button" class="rta-config-action" data-action="sheetDown" title="{{localize 'RTA.Template.MoveDown'}}" aria-label="{{localize 'RTA.Template.MoveDown'}}">↓</button><button type="button" class="rta-config-action" data-action="removeSheetComponent" title="{{localize 'RTA.Template.RemoveComponent'}}" aria-label="{{localize 'RTA.Template.RemoveComponent'}}"><i class="fa-solid fa-trash"></i></button>{{/unless}}</div><div class="rta-sheet-component__config"><label>{{localize "RTA.Template.Source"}}<select data-sheet-prop="source" {{#if ../readOnly}}disabled{{/if}}>{{#each sourceChoices}}<option value="{{token}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>{{localize "RTA.Template.Width"}}<select data-sheet-prop="width" {{#if ../readOnly}}disabled{{/if}}><option value="full" {{#if isFull}}selected{{/if}}>{{localize "RTA.Template.Full"}}</option><option value="half" {{#if isHalf}}selected{{/if}}>{{localize "RTA.Template.Half"}}</option></select></label><label><input type="checkbox" data-sheet-prop="editable" {{#if editable}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{localize "RTA.Template.Editable"}}</label></div><div class="rta-sheet-component__preview"><strong>{{#if label}}{{label}}{{else}}{{kind}}{{/if}}</strong>{{#if sourceToken}}<small>{{localize "RTA.Template.BoundSource"}}</small>{{else}}<small>{{localize "RTA.Template.PresentationComponent"}}</small>{{/if}}</div></article>{{else}}<div class="rta-sheet-builder__empty">{{localize "RTA.Template.EmptySheetAddTheFirstComponent"}}</div>{{/each}}
          </div>
        </fieldset>
      {{/if}}

      {{#if isCreationSystem}}
        <fieldset><legend>{{localize "RTA.Template.CreationSystem"}}</legend>
          {{> rtaIdentityName}}
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.Description"}}</label><textarea name="descriptionKey" rows="2" {{#if readOnly}}readonly{{/if}}>{{data.descriptionKey}}</textarea></div>
          {{> rtaEnabled}}
        </fieldset>
        <details class="rta-config-entry__section" open>
          <summary>{{localize "RTA.Template.CreationSteps"}}</summary>
          <div class="rta-config-entry__section-heading"><p>{{localize "RTA.Template.ArrangeTheStepsOfThisRulesetThisEditorConfiguresTheJourneyItDoesNotExecuteCharacterCreation"}}</p>{{#unless readOnly}}<button type="button" data-action="addCreationStep"><i class="fa-solid fa-plus"></i> {{localize "RTA.Template.AddStep"}}</button>{{/unless}}</div>
          <div class="rta-field-editor-list" data-creation-steps>{{#each creationStepRows}}{{{html}}}{{/each}}</div>
        </details>
      {{/if}}

      {{#if isModifier}}
        <fieldset><legend>{{localize "RTA.Template.Modifier"}}</legend>
          {{> rtaIdentityName}}
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.Target"}}</label><select name="targetRef" required>{{#each modifierTargetChoices}}<option value="{{token}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.Operation"}}</label><select name="operation" {{#if readOnly}}disabled{{/if}}>{{#each modifierOperationChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select></div>
          {{> rtaOperandEditor}}
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.Stacking"}}</label><select name="stackingMode" {{#if readOnly}}disabled{{/if}}>{{#each stackingModeChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select></div>
          <div class="form-group rta-form-row" data-stacking-group {{#unless showStackingGroup}}hidden{{/unless}}><label>{{localize "RTA.Template.StackingGroup"}}</label><input name="stackingGroup" value="{{stackingGroup}}" placeholder="{{localize 'RTA.Template.StackingGroupHint'}}" {{#if readOnly}}readonly{{/if}}></div>
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.ApplicationOrder"}}</label><input name="priority" type="number" step="1" value="{{data.priority}}" {{#if readOnly}}readonly{{/if}}></div>
          {{> rtaConditionsPicker}}
          {{> rtaEnabled}}
        </fieldset>
        {{> rtaNotesSection}}
      {{/if}}

      {{#if isDuration}}
        <fieldset><legend>{{localize "RTA.Template.Duration"}}</legend>
          {{> rtaIdentityName}}
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.Mode"}}</label><select name="durationMode" {{#if readOnly}}disabled{{/if}}>{{#each durationModeChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select></div>
          <div class="form-group rta-form-row" data-duration-mode="fixed" {{#unless durationShows.fixed}}hidden{{/unless}}><label>{{localize "RTA.Template.Amount"}}</label><input name="durationAmount" type="number" min="0" step="any" value="{{durationAmount}}" {{#if readOnly}}readonly{{/if}}></div>
          <div class="form-group rta-form-row" data-duration-mode="fixed" {{#unless durationShows.fixed}}hidden{{/unless}}><label>{{localize "RTA.Template.Unit"}}</label><select name="durationUnit" {{#if readOnly}}disabled{{/if}}>{{#each durationUnitChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select></div>
          <div class="form-group rta-form-row" data-duration-mode="untilEvent" {{#unless durationShows.untilEvent}}hidden{{/unless}}><label>{{localize "RTA.Template.EventType"}}</label><select name="durationEventTypeRef" {{#if readOnly}}disabled{{/if}}>{{#each durationEventChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
          <div class="form-group rta-form-row" data-duration-mode="whileCondition" {{#unless durationShows.whileCondition}}hidden{{/unless}}><label>{{localize "RTA.Template.Condition"}}</label><select name="durationConditionRef" {{#if readOnly}}disabled{{/if}}>{{#each durationConditionChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
          <div class="form-group rta-form-row" data-duration-mode="absoluteTime" {{#unless durationShows.absoluteTime}}hidden{{/unless}}><label>{{localize "RTA.Template.WorldTimeSeconds"}}</label><input name="durationAt" type="number" min="0" step="1" value="{{durationAt}}" {{#if readOnly}}readonly{{/if}}></div>
          {{> rtaEnabled}}
        </fieldset>
        {{> rtaNotesSection}}
      {{/if}}

      {{#if isGeneric}}
        <fieldset><legend>{{title}}</legend><textarea name="genericJson" rows="24" {{#if readOnly}}readonly{{/if}}>{{genericJson}}</textarea></fieldset>
      {{/if}}
      {{#if hasRelations}}
        <details class="rta-config-entry__section" data-generic-relations>
          <summary><strong>{{localize "RTA.Relations.Title"}}</strong> <span data-live-count="[data-relation-list] > [data-relation-row]">{{relationRows.length}}</span></summary>
          <p>{{localize "RTA.Relations.Explanation"}}</p>
          <div data-relation-list>
          {{#each relationRows}}
            <article class="rta-generic-relation" data-relation-row data-relation-id="{{id}}">
              <div class="rta-generic-relation__fields">
                <div class="form-group rta-form-row"><label>{{localize "RTA.Relations.Operation"}}</label><select data-relation-operation {{#if ../readOnly}}disabled{{/if}}>
                  {{#each operationChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{#if isLink}}{{localize "RTA.Relations.Link"}}{{else}}{{#if isUnlock}}{{localize "RTA.Relations.Unlock"}}{{else}}{{localize "RTA.Relations.Grant"}}{{/if}}{{/if}}</option>{{/each}}
                </select></div>
                <div class="form-group rta-form-row"><label>{{localize "RTA.Relations.Target"}}</label><select data-relation-target {{#if ../readOnly}}disabled{{/if}}>
                  {{#each targetChoices}}<option value="{{token}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select></div>
              </div>
              <details class="rta-config-entry__technical"><summary>{{localize "RTA.Relations.Parameters"}}</summary><textarea rows="3" data-relation-config {{#if ../readOnly}}readonly{{/if}}>{{configJson}}</textarea></details>
              {{#unless ../readOnly}}<button type="button" data-action="removeRelation" class="rta-config-action" title="{{localize 'RTA.Relations.Remove'}}"><i class="fa-solid fa-trash"></i></button>{{/unless}}
            </article>
          {{/each}}
          </div>
          {{#unless readOnly}}<button type="button" data-action="addRelation"><i class="fa-solid fa-plus"></i> {{localize "RTA.Relations.Add"}}</button>{{/unless}}
        </details>
      {{/if}}
    </div>

    <footer class="form-footer rta-config-entry__footer">
      {{#unless creating}}{{#unless readOnly}}<span class="rta-delete-guard" {{#if deletion.blocked}}data-tooltip="{{deletion.reason}}" aria-label="{{deletion.reason}}"{{/if}}><button type="button" data-action="delete" {{#if deletion.blocked}}disabled{{/if}}><i class="fa-solid fa-trash"></i> {{localize "RTA.Template.Delete"}}</button></span>{{/unless}}{{/unless}}
      <div class="rta-config-entry__footer-actions">
        <button type="button" data-action="close" data-footer-action="close" {{#if dirty}}hidden{{/if}}>{{localize "RTA.Template.Close"}}</button>
        {{#unless readOnly}}<button type="button" data-action="cancel" data-footer-action="cancel" {{#unless dirty}}hidden{{/unless}}><i class="fa-solid fa-arrow-rotate-left"></i> {{localize "RTA.Template.Cancel"}}</button>{{/unless}}
        {{#unless readOnly}}<button type="submit" data-persist {{#unless canPersist}}disabled{{/unless}}>{{localize "RTA.Template.Apply"}}</button>{{/unless}}
        {{#unless readOnly}}<button type="button" data-action="saveQuit" data-persist {{#unless canPersist}}disabled{{/unless}}>{{localize "RTA.Template.SaveQuit"}}</button>{{/unless}}
      </div>
    </footer>
  </form>
</section>
