{{#*inline "rtaPresentationEditor"}}
  <p class="hint">{{localize "RTA.Declarative.PresentationHelp"}}</p>
  {{#each presentationRows}}
    <div class="form-group rta-form-row rta-declarative-presentation" data-presentation-key="{{key}}">
      <label>{{key}}</label>
      <div class="rta-form-row__control rta-declarative-presentation__controls">
        <label class="rta-declarative-toggle"><input type="checkbox" data-presentation-override {{#if active}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{localize "RTA.Declarative.Override"}}</label>
        <span class="rta-declarative-presentation__value" {{#unless active}}hidden{{/unless}}>
          {{#if isBoolean}}<label class="rta-declarative-toggle"><input type="checkbox" data-presentation-value {{#if checked}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{key}}</label>{{else}}
            <input data-presentation-value type="text" value="{{value}}" {{#if ../readOnly}}readonly{{/if}}>
          {{/if}}
        </span>
      </div>
    </div>
  {{/each}}
{{/inline}}
{{#*inline "rtaPickerSearch"}}<input type="search" data-picker-filter placeholder="{{placeholder}}">{{/inline}}
{{#*inline "rtaIdentityName"}}<div class="form-group rta-form-row"><label>{{localize "RTA.Template.Name"}}</label><input name="nameKey" value="{{data.nameKey}}" required {{#if readOnly}}readonly{{/if}}></div>{{/inline}}
{{#*inline "rtaIdentityDescription"}}<div class="form-group rta-form-row"><label>{{localize "RTA.Template.Description"}}</label><input name="descriptionKey" value="{{data.descriptionKey}}" {{#if readOnly}}readonly{{/if}}></div>{{/inline}}
{{#*inline "rtaNotesSection"}}<details class="rta-config-entry__section" data-notes><summary><strong>{{#if noTags}}{{localize "RTA.Template.NotesOnly"}}{{else}}{{localize "RTA.Template.Notes"}}{{/if}}</strong></summary>{{> rtaIdentityDescription}}{{#unless noTags}}{{> rtaTagsPicker}}{{/unless}}</details>{{/inline}}
{{#*inline "rtaOperandEditor"}}<div class="form-group rta-form-row" {{#unless effectNeedsOperand}}hidden{{/unless}}><label>{{localize "RTA.Template.ValueSource"}}</label><select name="operandKind"><option value="literal" {{#if isOperandLiteral}}selected{{/if}}>{{localize "RTA.Template.LiteralValue"}}</option><option value="parameter" {{#if isOperandParameter}}selected{{/if}}>{{localize "RTA.Template.Parameter"}}</option><option value="formula" {{#if isOperandFormula}}selected{{/if}}>{{localize "RTA.Template.Formula"}}</option><option value="reference" {{#if isOperandReference}}selected{{/if}}>{{localize "RTA.Template.Reference"}}</option></select></div><div class="form-group rta-form-row" data-operand-editor="literal" {{#unless showOperand.literal}}hidden{{/unless}}><label>{{localize "RTA.Template.Value"}}</label><input name="operandLiteral" type="number" value="{{operandLiteral}}"></div><div class="form-group rta-form-row" data-operand-editor="parameter" {{#unless showOperand.parameter}}hidden{{/unless}}><label>{{localize "RTA.Template.Parameter"}}</label><select name="operandSourceId">{{#each parameterChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div><div class="form-group rta-form-row" data-operand-editor="formula" {{#unless showOperand.formula}}hidden{{/unless}}><label>{{localize "RTA.Template.Formula"}}</label><select name="operandSourceId">{{#each formulaChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div><div class="form-group rta-form-row" data-operand-editor="reference" {{#unless showOperand.reference}}hidden{{/unless}}><label>{{localize "RTA.Template.Reference"}}</label><select name="operandReference">{{#each operandReferenceChoices}}<option value="{{token}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>{{/inline}}
{{#*inline "rtaConditionsPicker"}}<details class="rta-picker rta-config-entry__section" data-picker><summary><strong>{{localize "RTA.Template.Conditions"}}</strong><span data-picker-summary>{{conditionSummary}}</span></summary><div class="rta-picker__body rta-choice-list">{{> rtaPickerSearch placeholder=(localize "RTA.Template.SearchConditions")}}{{#each conditionChoices}}<label data-picker-option data-picker-label="{{label}}" data-rta-colors="{{colors}}"><input type="checkbox" name="conditionRefs" value="{{id}}" {{#if selected}}checked{{/if}}> {{label}}</label>{{else}}<p>{{localize "RTA.Template.NoConditionsAvailable"}}</p>{{/each}}</div></details>{{/inline}}
{{#*inline "rtaPermissionRule"}}<article class="rta-field-editor" data-permission-rule data-rule-id="{{id}}" data-rule-original="{{original}}"><details class="rta-field-editor__details" {{#if isNew}}open{{/if}}><summary><span><strong>{{#if isAllow}}{{localize "RTA.Template.Allow"}}{{else}}{{localize "RTA.Template.Deny"}}{{/if}}</strong><small>{{#each operationChoices}}{{#if selected}} · {{localize labelKey}}{{/if}}{{/each}}</small></span>{{#unless @root.readOnly}}<button type="button" data-action="removePermissionRule" class="rta-config-action" title="{{localize 'RTA.Permission.RemoveRule'}}" aria-label="{{localize 'RTA.Permission.RemoveRule'}}"><i class="fa-solid fa-trash"></i></button>{{/unless}}</summary><div class="rta-field-editor__body"><div class="form-group rta-form-row"><label>{{localize "RTA.Permission.Effect"}}</label><select data-rule-prop="effect" {{#if @root.readOnly}}disabled{{/if}}><option value="ALLOW" {{#if isAllow}}selected{{/if}}>{{localize "RTA.Template.Allow"}}</option><option value="DENY" {{#unless isAllow}}selected{{/unless}}>{{localize "RTA.Template.Deny"}}</option></select></div><div class="rta-config-entry__check-group rta-choice-list" data-rta-select-label="{{localize 'RTA.Permission.Operations'}}">{{#each operationChoices}}<label><input type="checkbox" data-rule-prop="operations" value="{{id}}" {{#if selected}}checked{{/if}} {{#if @root.readOnly}}disabled{{/if}}> {{localize labelKey}}</label>{{/each}}</div><div class="rta-config-entry__check-group rta-choice-list" data-rta-select-label="{{localize 'RTA.Permission.Roles'}}">{{#each roleChoices}}<label><input type="checkbox" data-rule-prop="roles" value="{{id}}" {{#if selected}}checked{{/if}} {{#if @root.readOnly}}disabled{{/if}}> {{localize labelKey}}</label>{{/each}}</div><div class="form-group rta-form-row"><label>{{localize "RTA.Permission.MinimumOwnership"}}</label><select data-rule-prop="minimumOwnership" {{#if @root.readOnly}}disabled{{/if}}>{{#each ownershipChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select></div><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Condition"}}</label><select data-rule-prop="conditionRef" {{#if @root.readOnly}}disabled{{/if}}>{{#each conditionChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Priority"}}</label><input type="number" step="1" data-rule-prop="priority" value="{{priority}}" {{#if @root.readOnly}}readonly{{/if}}></div><div class="form-group rta-form-row"><label>{{localize "RTA.Permission.DenialMessage"}}</label><input data-rule-prop="messageKey" value="{{messageKey}}" placeholder="{{localize 'RTA.Permission.DenialMessageHint'}}" {{#if @root.readOnly}}readonly{{/if}}></div></div></details></article>{{/inline}}
{{#*inline "rtaTriggerFilterRow"}}<div class="rta-trigger-filter" data-trigger-filter-row><label>{{localize "RTA.Trigger.PayloadField"}}<select data-filter-field {{#if @root.readOnly}}disabled{{/if}}><option value=""></option>{{#each fieldChoices}}<option value="{{id}}" data-event-type="{{eventTypeId}}" data-value-type="{{valueType}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select></label><label>{{localize "RTA.Trigger.EqualsValue"}}<input data-filter-value value="{{valueText}}" {{#if @root.readOnly}}readonly{{/if}}></label>{{#unless @root.readOnly}}<button type="button" class="rta-config-action" data-action="removeTriggerFilter" title="{{localize 'RTA.Trigger.RemoveFilter'}}" aria-label="{{localize 'RTA.Trigger.RemoveFilter'}}"><i class="fa-solid fa-trash"></i></button>{{/unless}}</div>{{/inline}}
{{#*inline "rtaFieldRow"}}<article class="rta-field-editor" data-field-definition-row data-field-id="{{id}}"><details class="rta-field-editor__details" {{#if isNew}}open{{/if}}><summary><span><strong>{{#if isNew}}{{localize "RTA.DynamicMarkup.NewField"}}{{else}}{{name}}{{/if}}</strong><small> · {{valueType}} · {{cardinality}}{{#if required}} · {{localize "RTA.Template.RequiredLower"}}{{/if}}{{#if hasDefault}} · {{localize "RTA.Template.DefaultLower"}} {{defaultText}}{{/if}}</small></span>{{#unless @root.readOnly}}<button type="button" data-action="removeField" class="rta-config-action" title="{{localize 'RTA.Template.RemoveField'}}" aria-label="{{localize 'RTA.Template.RemoveField'}}"><i class="fa-solid fa-trash"></i></button>{{/unless}}</summary><div class="rta-field-editor__body"><div class="rta-field-editor__grid"><label>{{localize "RTA.Template.Name"}}<input data-field-prop="name" value="{{name}}" required {{#if @root.readOnly}}readonly{{/if}}></label><label>{{localize "RTA.Template.ValueType"}}<select data-field-prop="valueType" {{#if @root.readOnly}}disabled{{/if}}>{{#each valueTypes}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{id}}</option>{{/each}}</select></label><label>{{localize "RTA.Template.Cardinality"}}<select data-field-prop="cardinality" {{#if @root.readOnly}}disabled{{/if}}><option value="one" {{#if isOne}}selected{{/if}}>{{localize "RTA.Template.One"}}</option><option value="many" {{#if isMany}}selected{{/if}}>{{localize "RTA.Template.Many"}}</option></select></label><label class="rta-field-editor__check"><input type="checkbox" data-field-prop="required" {{#if required}}checked{{/if}} {{#if @root.readOnly}}disabled{{/if}}> {{localize "RTA.Template.Required"}}</label><label class="rta-field-editor__check"><input type="checkbox" data-field-prop="nullable" {{#if nullable}}checked{{/if}} {{#if @root.readOnly}}disabled{{/if}}> {{localize "RTA.Template.Nullable"}}</label><label>{{localize "RTA.Template.DefaultValue"}}<textarea data-field-prop="defaultValue" rows="2" placeholder="{{localize 'RTA.Template.NoDefault'}}" {{#if @root.readOnly}}readonly{{/if}}>{{defaultText}}</textarea></label></div><div class="rta-field-editor__numeric" data-field-numeric {{#unless isNumeric}}hidden{{/unless}}><label>{{localize "RTA.Template.Minimum"}}<input type="number" data-field-prop="min" value="{{min}}" {{#if @root.readOnly}}readonly{{/if}}></label><label>{{localize "RTA.Template.Maximum"}}<input type="number" data-field-prop="max" value="{{max}}" {{#if @root.readOnly}}readonly{{/if}}></label><label>{{localize "RTA.Template.Step"}}<input type="number" min="0" data-field-prop="step" value="{{step}}" {{#if @root.readOnly}}readonly{{/if}}></label></div><div class="rta-field-editor__grid" data-field-reference {{#unless isReference}}hidden{{/unless}}><label>{{localize "RTA.Template.ReferenceTarget"}}<select data-field-prop="referenceTargetKind" {{#if @root.readOnly}}disabled{{/if}}><option value="">{{localize "RTA.Template.AnyKind"}}</option><option value="roll" {{#if refRoll}}selected{{/if}}>{{localize "RTA.Template.Roll"}}</option><option value="formula" {{#if refFormula}}selected{{/if}}>{{localize "RTA.Template.Formula"}}</option><option value="definition" {{#if refDefinition}}selected{{/if}}>{{localize "RTA.Template.Definition"}}</option><option value="parameter" {{#if refParameter}}selected{{/if}}>{{localize "RTA.Template.Parameter"}}</option><option value="test" {{#if refTest}}selected{{/if}}>{{localize "RTA.Template.Test"}}</option><option value="action" {{#if refAction}}selected{{/if}}>{{localize "RTA.Template.Action"}}</option><option value="contentTemplate" {{#if refContent}}selected{{/if}}>{{localize "RTA.Template.Content"}}</option></select></label><label data-field-definition-type {{#unless refDefinition}}hidden{{/unless}}>{{localize "RTA.Template.DefinitionType"}}<select data-field-prop="referenceDefinitionTypeId" {{#if @root.readOnly}}disabled{{/if}}><option value="">{{localize "RTA.Template.AnyDefinitionType"}}</option>{{#each definitionTypeChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div><details class="rta-config-entry__technical"><summary>{{localize "RTA.Template.Technical"}}</summary><label>{{localize "RTA.Template.Id"}}<input data-field-prop="id" value="{{id}}" readonly></label></details></div></details></article>{{/inline}}
{{#*inline "rtaEnabled"}}<div class="form-group rta-form-row"><label>{{localize "RTA.Template.Enabled"}}</label><input name="enabled" type="checkbox" {{#if data.enabled}}checked{{/if}} {{#if readOnly}}disabled{{/if}}></div>{{/inline}}
{{#*inline "rtaValueSource"}}<div class="form-group rta-form-row"><label class="rta-form-row__label">{{label}}</label><div class="rta-value-source" data-slot-source="{{bound}}"><select data-source-kind {{#if @root.readOnly}}disabled{{/if}}>{{#each source.kinds}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select><span class="rta-value-source__input" data-source-box="literal" {{#unless source.isLiteral}}hidden{{/unless}}><input type="number" step="any" data-source-literal value="{{source.literal}}" {{#if @root.readOnly}}readonly{{/if}}></span><span class="rta-value-source__input" data-source-box="formula" {{#unless source.isFormula}}hidden{{/unless}}><select data-source-formula {{#if @root.readOnly}}disabled{{/if}}><option value="">—</option>{{#each source.formulas}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></span></div></div>{{/inline}}
{{#*inline "rtaTestInputCard"}}<article class="rta-binding-card" data-test-input><div class="rta-config-entry__section-heading"><strong>{{#if id}}{{id}}{{else}}{{localize "RTA.TestInput.New"}}{{/if}}</strong><button type="button" class="rta-config-action" data-action="removeTestInput" title="{{localize 'RTA.TestInput.Remove'}}" aria-label="{{localize 'RTA.TestInput.Remove'}}" {{#if @root.readOnly}}disabled{{/if}}><i class="fa-solid fa-trash"></i></button></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.TestInput.Id"}}</label><input data-input-prop="id" value="{{id}}" {{#if @root.readOnly}}readonly{{/if}}></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Slots.ValueType"}}</label><select data-input-prop="valueType" {{#if @root.readOnly}}disabled{{/if}}>{{#each valueTypes}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{id}}</option>{{/each}}</select></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.TestInput.SourceLabel"}}</label><div class="rta-value-source"><select data-input-prop="sourceKind" {{#if @root.readOnly}}disabled{{/if}}>{{#each sourceKinds}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select><span class="rta-value-source__input" data-input-source-box="literal" {{#unless isLiteral}}hidden{{/unless}}><input data-input-prop="literal" value="{{literal}}" {{#if @root.readOnly}}readonly{{/if}}></span><span class="rta-value-source__input" data-input-source-box="formula" {{#unless isFormula}}hidden{{/unless}}><select data-input-prop="formulaRef" {{#if @root.readOnly}}disabled{{/if}}><option value="">—</option>{{#each formulas}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></span><span class="rta-value-source__input" data-input-source-box="reference" {{#unless isReference}}hidden{{/unless}}><select data-input-prop="reference" {{#if @root.readOnly}}disabled{{/if}}><option value="">—</option>{{#each references}}<option value="{{token}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></span></div></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.TestInput.Required"}}</label><input type="checkbox" data-input-prop="required" {{#if required}}checked{{/if}} {{#if @root.readOnly}}disabled{{/if}}></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.TestInput.Default"}}</label><input data-input-prop="defaultValue" value="{{defaultValue}}" {{#if @root.readOnly}}readonly{{/if}}></div></article>{{/inline}}
{{#*inline "rtaPoolCard"}}<article class="rta-binding-card" data-slot-card="pool" data-slot-original="{{id}}"><div class="rta-config-entry__section-heading"><strong>{{#if id}}{{id}}{{else}}{{localize "RTA.Slots.NewPool"}}{{/if}}</strong><button type="button" class="rta-config-action" data-action="removeSlot" title="{{localize 'RTA.Slots.Remove'}}" aria-label="{{localize 'RTA.Slots.Remove'}}" {{#if @root.readOnly}}disabled{{/if}}><i class="fa-solid fa-trash"></i></button></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Slots.Id"}}</label><input data-slot-prop="id" value="{{id}}" {{#if @root.readOnly}}readonly{{/if}}></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Slots.ValueType"}}</label><select data-slot-prop="valueType" {{#if @root.readOnly}}disabled{{/if}}>{{#each valueTypes}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{id}}</option>{{/each}}</select></div>{{> rtaValueSource label=(localize "RTA.Template.Minimum") bound="minimum" source=minimum}}{{> rtaValueSource label=(localize "RTA.Template.Maximum") bound="maximum" source=maximum}}{{> rtaValueSource label=(localize "RTA.Slots.Initial") bound="initial" source=initial}}<div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Slots.Underflow"}}</label><select data-slot-prop="underflowPolicy" {{#if @root.readOnly}}disabled{{/if}}>{{#each underflow}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Slots.Overflow"}}</label><select data-slot-prop="overflowPolicy" {{#if @root.readOnly}}disabled{{/if}}>{{#each overflow}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select></div></article>{{/inline}}
{{#*inline "rtaCollectionCard"}}<article class="rta-binding-card" data-slot-card="collection" data-slot-original="{{id}}"><div class="rta-config-entry__section-heading"><strong>{{#if id}}{{id}}{{else}}{{localize "RTA.Slots.NewCollection"}}{{/if}}</strong><button type="button" class="rta-config-action" data-action="removeSlot" title="{{localize 'RTA.Slots.Remove'}}" aria-label="{{localize 'RTA.Slots.Remove'}}" {{#if @root.readOnly}}disabled{{/if}}><i class="fa-solid fa-trash"></i></button></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Slots.Id"}}</label><input data-slot-prop="id" value="{{id}}" {{#if @root.readOnly}}readonly{{/if}}></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Slots.EntryMode"}}</label><select data-slot-prop="entryMode" {{#if @root.readOnly}}disabled{{/if}}>{{#each entryModes}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select></div><div class="form-group rta-form-row" data-slot-kinds="content" {{#if isValueMode}}hidden{{/if}}><label class="rta-form-row__label">{{localize "RTA.Slots.AllowedContent"}}</label><div class="rta-config-entry__check-group rta-choice-list">{{#each contentKinds}}<label><input type="checkbox" data-slot-kind="slotContentKind" value="{{id}}" {{#if selected}}checked{{/if}} {{#if @root.readOnly}}disabled{{/if}}> {{label}}</label>{{else}}<p>{{localize "RTA.Slots.NoContentTypes"}}</p>{{/each}}</div></div><div class="form-group rta-form-row" data-slot-kinds="value" {{#unless isValueMode}}hidden{{/unless}}><label class="rta-form-row__label">{{localize "RTA.Slots.AllowedValues"}}</label><div class="rta-config-entry__check-group rta-choice-list">{{#each valueKinds}}<label><input type="checkbox" data-slot-kind="slotValueKind" value="{{id}}" {{#if selected}}checked{{/if}} {{#if @root.readOnly}}disabled{{/if}}> {{label}}</label>{{/each}}</div></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Slots.MinimumEntries"}}</label><input type="number" min="0" step="1" data-slot-prop="minimumEntries" value="{{minimumEntries}}" {{#if @root.readOnly}}readonly{{/if}}></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Slots.MaximumEntries"}}</label><input type="number" min="0" step="1" data-slot-prop="maximumEntries" value="{{maximumEntries}}" {{#if @root.readOnly}}readonly{{/if}}></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Slots.Capacity"}}</label><select data-slot-prop="capacityFormulaRef" {{#if @root.readOnly}}disabled{{/if}}><option value="">—</option>{{#each capacity}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div><div class="form-group rta-form-row"><label class="rta-form-row__label">{{localize "RTA.Template.Unique"}}</label><input type="checkbox" data-slot-prop="unique" {{#if unique}}checked{{/if}} {{#if @root.readOnly}}disabled{{/if}}></div></article>{{/inline}}
{{#*inline "rtaCategoriesPicker"}}<details class="rta-picker rta-config-entry__section" data-picker><summary><strong>{{localize "RTA.Template.Categories"}}</strong><span data-picker-summary>{{categorySummary}}</span></summary><div class="rta-picker__body rta-choice-list">{{> rtaPickerSearch placeholder=(localize "RTA.Template.SearchCategories")}}{{#each categoryChoices}}<label data-picker-option data-picker-label="{{label}}" data-rta-colors="{{colors}}"><input type="checkbox" name="categories" value="{{id}}" {{#if selected}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{label}}</label>{{else}}<p>{{localize "RTA.Template.NoCategoriesYet"}}</p>{{/each}}</div></details>{{/inline}}
{{#*inline "rtaTagsPicker"}}<details class="rta-picker rta-config-entry__section" data-picker><summary><strong>{{localize "RTA.Template.Tags"}}</strong><span data-picker-summary>{{tagSummary}}</span></summary><div class="rta-picker__body rta-choice-list">{{> rtaPickerSearch placeholder=(localize "RTA.Template.SearchTags")}}{{#each tagChoices}}<label data-picker-option data-picker-label="{{label}}" data-rta-colors="{{colors}}"><input type="checkbox" name="tags" value="{{id}}" {{#if selected}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{label}}</label>{{else}}<p>{{localize "RTA.Template.NoTagsYetCreateThemFromTheTagsSection"}}</p>{{/each}}</div></details>{{/inline}}
<section class="rta-config-entry">
  {{#if error}}<p class="rta-configurator__error" role="alert">{{error}}</p>{{/if}}
  <form data-entry-form>
    <div data-entry-scroll class="rta-config-entry__scroll">
      {{#if readOnly}}<p><i class="fa-solid fa-lock"></i> {{localize "RTA.Template.ValidatedVersionReadOnly"}}</p>{{/if}}
      {{#if help}}<details class="rta-config-entry__section rta-config-entry__help" data-entry-help><summary><strong><i class="fa-solid fa-circle-question" aria-hidden="true"></i> {{localize "RTA.Help.Title"}}</strong></summary><div class="rta-config-entry__help-body"><p>{{localize help.summaryKey}}</p><p>{{localize help.usageKey}}</p>{{#if help.typeDescription}}<p><strong>{{localize "RTA.Help.TypeHelp"}} :</strong> {{help.typeDescription}}</p>{{/if}}</div></details>{{/if}}

      {{#if isRuleset}}
        <fieldset><legend>{{localize "RTA.Template.General"}}</legend>
          {{> rtaIdentityName}}
          {{> rtaIdentityDescription}}
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.Version"}}</label><input name="version" value="{{data.version}}" required {{#if readOnly}}readonly{{/if}}></div>
        </fieldset>
        <fieldset><legend>{{localize "RTA.Colors.Appearance"}}</legend>
          <div class="form-group rta-form-row"><label>{{localize "RTA.Colors.RulesetColor"}}</label><input name="rulesetColor" type="color" value="{{rulesetMainColor}}" {{#if readOnly}}disabled{{/if}}></div>
        </fieldset>
        <details class="rta-config-entry__section"><summary>{{localize "RTA.Colors.Sections"}}</summary>
          <p>{{localize "RTA.Colors.InheritanceHelp"}}</p>
          {{#each colorSectionChoices}}
            <div class="rta-section-color-config" style="--rta-section-color:{{color}}">
              <div class="form-group rta-form-row"><label>{{title}}</label><input type="color" name="sectionColor:{{id}}" value="{{color}}" {{#if ../readOnly}}disabled{{/if}}></div>
