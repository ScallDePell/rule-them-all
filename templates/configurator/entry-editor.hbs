<section class="rta-config-entry">
  {{#if error}}<p class="rta-configurator__error" role="alert">{{error}}</p>{{/if}}
  <form data-entry-form>
    <div data-entry-scroll class="rta-config-entry__scroll">
      {{#if readOnly}}<p><i class="fa-solid fa-lock"></i> {{localize "RTA.Template.ValidatedVersionReadOnly"}}</p>{{/if}}
      {{#if help}}<details class="rta-config-entry__section rta-config-entry__help" data-entry-help><summary><strong><i class="fa-solid fa-circle-question" aria-hidden="true"></i> {{localize "RTA.Help.Title"}}</strong></summary><div class="rta-config-entry__help-body"><p>{{localize help.summaryKey}}</p><p>{{localize help.usageKey}}</p>{{#if help.typeDescription}}<p><strong>{{localize "RTA.Help.TypeHelp"}} :</strong> {{help.typeDescription}}</p>{{/if}}</div></details>{{/if}}

      {{#if isRuleset}}
        <fieldset><legend>{{localize "RTA.Template.General"}}</legend>
          {{> rtaIdentityName}}
          {{> rtaIdentityDescription}}
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.Version"}}</label><input name="version" value="{{data.version}}" required {{#if readOnly}}readonly{{/if}}></div>
        </fieldset>
        <fieldset><legend>{{localize "RTA.Colors.Appearance"}}</legend>
          <div class="form-group rta-form-row"><label>{{localize "RTA.Colors.RulesetColor"}}</label><input name="rulesetColor" type="color" value="{{rulesetMainColor}}" {{#if readOnly}}disabled{{/if}}></div>
        </fieldset>
        {{#unless creating}}<fieldset><legend>{{localize "RTA.Initiative.Legend"}}</legend>
          <p>{{localize "RTA.Initiative.Help"}}</p>
          <div class="form-group rta-form-row"><label>{{localize "RTA.Initiative.Test"}}</label><select name="initiativeSource" {{#if readOnly}}disabled{{/if}}><option value="">{{localize "RTA.Initiative.GameSystem"}}</option>{{#each initiativeSourceChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
          <div class="form-group rta-form-row" data-initiative-only {{#unless initiativeChosen}}hidden{{/unless}}><label>{{localize "RTA.Initiative.TieBreak"}}</label><select name="initiativeTieBreakFormulaRef" {{#if readOnly}}disabled{{/if}}><option value="">{{localize "RTA.Initiative.NoTieBreak"}}</option>{{#each initiativeTieBreakChoices}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
          <div class="form-group rta-form-row" data-initiative-only {{#unless initiativeChosen}}hidden{{/unless}}><label for="rta-initiative-each-round">{{localize "RTA.Initiative.EachRound"}}</label><input id="rta-initiative-each-round" type="checkbox" name="initiativeEachRound" {{#if initiativeEachRound}}checked{{/if}} {{#if readOnly}}disabled{{/if}}></div>
          <div class="form-group rta-form-row" data-initiative-only {{#unless initiativeChosen}}hidden{{/unless}}><label for="rta-initiative-by-side">{{localize "RTA.Initiative.BySide"}}</label><input id="rta-initiative-by-side" type="checkbox" name="initiativeBySide" {{#if initiativeBySide}}checked{{/if}} {{#if readOnly}}disabled{{/if}}></div>
          <div class="form-group rta-form-row" data-initiative-only {{#unless initiativeChosen}}hidden{{/unless}}><label>{{localize "RTA.Initiative.PassStep"}}</label><input name="initiativePassStep" type="number" min="0" step="any" value="{{initiativePassStep}}" placeholder="{{localize 'RTA.Initiative.OnePass'}}" {{#if readOnly}}readonly{{/if}}></div>
          <div class="form-group rta-form-row" data-initiative-only {{#unless initiativeChosen}}hidden{{/unless}}><label>{{localize "RTA.Initiative.PassThreshold"}}</label><input name="initiativePassThreshold" type="number" step="any" value="{{initiativePassThreshold}}" placeholder="0" {{#if readOnly}}readonly{{/if}}></div>
        </fieldset>{{/unless}}
        {{#unless creating}}<fieldset><legend>{{localize "RTA.Shared.Legend"}}</legend>
          <p>{{localize "RTA.Shared.Help"}}</p>
          <div class="rta-config-entry__check-group rta-choice-list" data-rta-select-label="{{localize 'RTA.Shared.World'}}">{{#each sharedWorldChoices}}<label><input type="checkbox" name="sharedWorld" value="{{id}}" {{#if selected}}checked{{/if}} {{#if @root.readOnly}}disabled{{/if}}> {{label}}</label>{{/each}}</div>
          <div class="rta-config-entry__check-group rta-choice-list" data-rta-select-label="{{localize 'RTA.Shared.Combat'}}">{{#each sharedCombatChoices}}<label><input type="checkbox" name="sharedCombat" value="{{id}}" {{#if selected}}checked{{/if}} {{#if @root.readOnly}}disabled{{/if}}> {{label}}</label>{{/each}}</div>
        </fieldset>{{/unless}}
        <details class="rta-config-entry__section"><summary>{{localize "RTA.Colors.Sections"}}</summary>
          <p>{{localize "RTA.Colors.InheritanceHelp"}}</p>
