{{#*inline "rtaPresentationEditor"}}
  <p class="hint">{{localize "RTA.Declarative.PresentationHelp"}}</p>
  {{#each presentationRows}}
    <div class="form-group rta-form-row rta-declarative-presentation" data-presentation-key="{{key}}">
      <label>{{key}}</label>
      <div class="rta-form-row__control rta-declarative-presentation__controls">
        <label class="rta-declarative-toggle"><input type="checkbox" data-presentation-override {{#if active}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{localize "RTA.Declarative.Override"}}</label>
        <span class="rta-declarative-presentation__value" {{#unless active}}hidden{{/unless}}>
          {{#if isBoolean}}<label class="rta-declarative-toggle"><input type="checkbox" data-presentation-value {{#if checked}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{key}}</label>{{else}}
            <input data-presentation-value {{#if isNumber}}type="number" step="1"{{else}}type="text"{{/if}} value="{{value}}" {{#if ../readOnly}}readonly{{/if}}>
          {{/if}}
        </span>
      </div>
    </div>
  {{/each}}
{{/inline}}
{{#*inline "rtaPickerSearch"}}<input type="search" data-picker-filter placeholder="{{placeholder}}">{{/inline}}
{{#*inline "rtaIdentityName"}}<div class="form-group rta-form-row"><label>{{localize "RTA.Template.Name"}}</label><input name="nameKey" value="{{data.nameKey}}" required {{#if readOnly}}readonly{{/if}}></div>{{/inline}}
{{#*inline "rtaIdentityDescription"}}<div class="form-group rta-form-row"><label>{{localize "RTA.Template.Description"}}</label><input name="descriptionKey" value="{{data.descriptionKey}}" {{#if readOnly}}readonly{{/if}}></div>{{/inline}}
{{#*inline "rtaEnabled"}}<div class="form-group rta-form-row"><label>{{localize "RTA.Template.Enabled"}}</label><input name="enabled" type="checkbox" {{#if data.enabled}}checked{{/if}} {{#if readOnly}}disabled{{/if}}></div>{{/inline}}
{{#*inline "rtaTagsPicker"}}<details class="rta-picker rta-config-entry__section" data-picker><summary><strong>{{localize "RTA.Template.Tags"}}</strong><span data-picker-summary>{{tagSummary}}</span></summary><div class="rta-picker__body rta-choice-list">{{> rtaPickerSearch placeholder=(localize "RTA.Template.SearchTags")}}{{#each tagChoices}}<label data-picker-option data-picker-label="{{label}}" data-rta-colors="{{colors}}"><input type="checkbox" name="tags" value="{{id}}" {{#if selected}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{label}}</label>{{else}}<p>{{localize "RTA.Template.NoTagsYetCreateThemFromTheTagsSection"}}</p>{{/each}}</div></details>{{/inline}}
<section class="rta-config-entry">
  {{#if error}}<p class="rta-configurator__error" role="alert">{{error}}</p>{{/if}}
  <form data-entry-form>
    <div data-entry-scroll class="rta-config-entry__scroll">
      {{#if readOnly}}<p><i class="fa-solid fa-lock"></i> {{localize "RTA.Template.ValidatedVersionReadOnly"}}</p>{{/if}}

      {{#if isRuleset}}
        <fieldset><legend>{{localize "RTA.Template.General"}}</legend>
          {{> rtaIdentityName}}
          {{> rtaIdentityDescription}}
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.Version"}}</label><input name="version" value="{{data.version}}" required {{#if readOnly}}readonly{{/if}}></div>
        </fieldset>
        <fieldset><legend>{{localize "RTA.Colors.Appearance"}}</legend>
          <div class="form-group rta-form-row"><label>{{localize "RTA.Colors.RulesetColor"}}</label><input name="rulesetColor" type="color" value="{{rulesetMainColor}}" {{#if readOnly}}disabled{{/if}}></div>
        </fieldset>
        <details class="rta-config-entry__section" open><summary>{{localize "RTA.Colors.Sections"}}</summary>
          <p>{{localize "RTA.Colors.InheritanceHelp"}}</p>
          {{#each colorSectionChoices}}
            <div class="rta-section-color-config" style="--rta-section-color:{{color}}">
              <div class="form-group rta-form-row"><label>{{title}}</label><input type="color" name="sectionColor:{{id}}" value="{{color}}" {{#if ../readOnly}}disabled{{/if}}></div>
              <div class="form-group rta-form-row"><label for="rta-section-override-{{id}}">{{localize "RTA.Colors.AllowOverrides"}}</label><input id="rta-section-override-{{id}}" type="checkbox" name="sectionOverride:{{id}}" {{#if allowOverrides}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}></div>
            </div>
          {{/each}}
        </details>
        {{#unless creating}}<details class="rta-config-entry__section rta-config-entry__technical"><summary>{{localize "RTA.Template.Technical"}}</summary><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Id"}}</label><input value="{{data.id}}" readonly></div></details>{{/unless}}
      {{/if}}

      {{#if isDefinitionType}}
        <fieldset><legend>{{localize "RTA.Template.DefinitionType"}}</legend>
          {{> rtaIdentityName}}
          {{> rtaIdentityDescription}}
          <div data-color-override-editor>
            <div class="form-group rta-form-row"><label>{{localize "RTA.Colors.SubsectionColor"}}</label><span class="rta-color-override-control">{{#if allowTypeColor}}<input type="hidden" name="customColorPermission" value="1"><label class="rta-color-override-check"><input data-color-override-toggle type="checkbox" name="customColorEnabled" {{#if hasCustomColor}}checked{{/if}} {{#if readOnly}}disabled{{/if}}> {{localize "RTA.Colors.UseCustomColor"}}</label>{{/if}}<input data-custom-color-input name="color" type="color" value="{{#if data.color}}{{data.color}}{{else}}{{inheritedTypeColor}}{{/if}}" {{#unless allowTypeColor}}disabled{{else}}{{#unless hasCustomColor}}disabled{{/unless}}{{/unless}} {{#if readOnly}}disabled{{/if}}></span></div>
          </div>
          {{> rtaEnabled}}
        </fieldset>

        <details class="rta-config-entry__section" open><summary>{{localize "RTA.Template.Capabilities"}}</summary>
          <p>{{localize "RTA.Template.DefinitionTypesChooseEnginePluginCapabilitiesExecutableCapabilityBehaviorIsNotAuthoredHere"}}</p>
          <table class="rta-config-table rta-config-table--capabilities"><thead><tr><th>{{localize "RTA.Template.Capability"}}</th><th>{{localize "RTA.Template.Allowed"}}</th><th>{{localize "RTA.Template.Default"}}</th><th>{{localize "RTA.Template.Required"}}</th></tr></thead><tbody>
            {{#each capabilityChoices}}<tr><td>{{id}} <small>({{category}})</small></td><td><input type="checkbox" name="allowed:{{id}}" {{#if allowed}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}></td><td><input type="checkbox" name="default:{{id}}" {{#if default}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}></td><td><input type="checkbox" name="required:{{id}}" {{#if required}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}></td></tr>{{/each}}
          </tbody></table>
          <div class="rta-capability-contracts">
            {{#each capabilityChoices}}{{#if hasContract}}
              <details><summary>{{id}} {{localize "RTA.Template.ContractLower"}}</summary>
                {{#if fieldItems.length}}<h4>{{localize "RTA.Template.InjectedFields"}}</h4><table class="rta-config-table rta-config-table--compact"><thead><tr><th>{{localize "RTA.Template.Id"}}</th><th>{{localize "RTA.Template.Type"}}</th><th>{{localize "RTA.Template.Cardinality"}}</th><th>{{localize "RTA.Template.Required"}}</th></tr></thead><tbody>{{#each fieldItems}}<tr><td>{{id}}</td><td>{{valueType}}</td><td>{{cardinality}}</td><td>{{#if required}}{{localize "RTA.Template.Yes"}}{{else}}{{localize "RTA.Template.No"}}{{/if}}</td></tr>{{/each}}</tbody></table>{{/if}}
                {{#if outputItems.length}}<h4>{{localize "RTA.Template.Outputs"}}</h4><table class="rta-config-table rta-config-table--compact"><thead><tr><th>{{localize "RTA.Template.Id"}}</th><th>{{localize "RTA.Template.Type"}}</th><th>{{localize "RTA.Template.Source"}}</th><th>{{localize "RTA.Template.Read"}}</th><th>{{localize "RTA.Template.Mutable"}}</th></tr></thead><tbody>{{#each outputItems}}<tr><td>{{id}}</td><td>{{valueType}} / {{cardinality}}</td><td>{{source}}</td><td>{{#if readable}}{{localize "RTA.Template.Yes"}}{{else}}{{localize "RTA.Template.No"}}{{/if}}</td><td>{{#if mutable}}{{localize "RTA.Template.Yes"}}{{else}}{{localize "RTA.Template.No"}}{{/if}}</td></tr>{{/each}}</tbody></table>{{/if}}
              </details>
            {{/if}}{{/each}}
          </div>
        </details>

        <details class="rta-config-entry__section" open><summary>{{localize "RTA.Template.Fields"}}</summary>
          <div class="rta-config-entry__section-heading"><p>{{localize "RTA.Template.FieldsStoredIn"}} <code>Definition.data</code>{{localize "RTA.Template.CapabilityInjectedFieldsUseTheSameContractAndCannotCollide"}}</p>{{#unless readOnly}}<button type="button" data-action="addField"><i class="fa-solid fa-plus"></i> {{localize "RTA.Template.AddField"}}</button>{{/unless}}</div>
          <div class="rta-field-editor-list" data-field-definition-list>
            {{#each fieldRows}}
              <article class="rta-field-editor" data-field-definition-row data-field-id="{{id}}">
                <details class="rta-field-editor__details">
                  <summary><span><strong>{{name}}</strong><small> · {{valueType}} · {{cardinality}}{{#if required}} · {{localize "RTA.Template.RequiredLower"}}{{/if}}{{#if hasDefault}} · {{localize "RTA.Template.DefaultLower"}} {{defaultText}}{{/if}}</small></span>{{#unless ../readOnly}}<button type="button" data-action="removeField" class="rta-config-action" title="{{localize 'RTA.Template.RemoveField'}}"><i class="fa-solid fa-trash"></i></button>{{/unless}}</summary>
                  <div class="rta-field-editor__body">
                    <div class="rta-field-editor__grid">
                      <label>{{localize "RTA.Template.Name"}}<input data-field-prop="name" value="{{name}}" required {{#if ../readOnly}}readonly{{/if}}></label>
                      <label>{{localize "RTA.Template.ValueType"}}<select data-field-prop="valueType" {{#if ../readOnly}}disabled{{/if}}>{{#each valueTypes}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{id}}</option>{{/each}}</select></label>
                      <label>{{localize "RTA.Template.Cardinality"}}<select data-field-prop="cardinality" {{#if ../readOnly}}disabled{{/if}}><option value="one" {{#if isOne}}selected{{/if}}>{{localize "RTA.Template.One"}}</option><option value="many" {{#if isMany}}selected{{/if}}>{{localize "RTA.Template.Many"}}</option></select></label>
                      <label class="rta-field-editor__check"><input type="checkbox" data-field-prop="required" {{#if required}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{localize "RTA.Template.Required"}}</label>
                      <label class="rta-field-editor__check"><input type="checkbox" data-field-prop="nullable" {{#if nullable}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{localize "RTA.Template.Nullable"}}</label>
                      <label class="rta-field-editor__check"><input type="checkbox" data-field-prop="editable" {{#if editable}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{localize "RTA.Template.Editable"}}</label>
                      <label class="rta-field-editor__check"><input type="checkbox" data-field-prop="hasDefault" {{#if hasDefault}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{localize "RTA.Template.HasDefault"}}</label>
                      <label>{{localize "RTA.Template.DefaultValue"}}<textarea data-field-prop="defaultValue" rows="2" {{#if ../readOnly}}readonly{{/if}}>{{defaultText}}</textarea></label>
                    </div>
                    <div class="rta-field-editor__numeric" data-numeric-options>
                      <label>{{localize "RTA.Template.Minimum"}}<input type="number" data-field-prop="min" value="{{min}}" {{#if ../readOnly}}readonly{{/if}}></label>
                      <label>{{localize "RTA.Template.Maximum"}}<input type="number" data-field-prop="max" value="{{max}}" {{#if ../readOnly}}readonly{{/if}}></label>
                      <label>{{localize "RTA.Template.Step"}}<input type="number" min="0" data-field-prop="step" value="{{step}}" {{#if ../readOnly}}readonly{{/if}}></label>
                    </div>
                    <label>{{localize "RTA.Template.Description"}}<input data-field-prop="description" value="{{description}}" {{#if ../readOnly}}readonly{{/if}}></label>
                    <label>{{localize "RTA.Template.ReferenceTarget"}}<select data-field-prop="referenceTargetKind" {{#if ../readOnly}}disabled{{/if}}><option value="">{{localize "RTA.Template.OnlyForReferenceFields"}}</option><option value="roll" {{#if refRoll}}selected{{/if}}>{{localize "RTA.Template.Roll"}}</option><option value="formula" {{#if refFormula}}selected{{/if}}>{{localize "RTA.Template.Formula"}}</option><option value="definition" {{#if refDefinition}}selected{{/if}}>{{localize "RTA.Template.Definition"}}</option><option value="parameter" {{#if refParameter}}selected{{/if}}>{{localize "RTA.Template.Parameter"}}</option><option value="test" {{#if refTest}}selected{{/if}}>{{localize "RTA.Template.Test"}}</option><option value="action" {{#if refAction}}selected{{/if}}>{{localize "RTA.Template.Action"}}</option><option value="contentTemplate" {{#if refContent}}selected{{/if}}>{{localize "RTA.Template.Content"}}</option></select></label>
                    <details><summary>{{localize "RTA.Template.AdvancedFieldContract"}}</summary><label>{{localize "RTA.Template.OtherConstraintsJson"}}<textarea data-field-prop="constraints" rows="3" {{#if ../readOnly}}readonly{{/if}}>{{constraintsJson}}</textarea></label><label>{{localize "RTA.Template.ReferenceTargetJson"}}<textarea data-field-prop="referenceTarget" rows="3" {{#if ../readOnly}}readonly{{/if}}>{{referenceTargetJson}}</textarea></label><label>{{localize "RTA.Template.PresentationJson"}}<textarea data-field-prop="presentation" rows="3" {{#if ../readOnly}}readonly{{/if}}>{{presentationJson}}</textarea></label></details>
                    <details class="rta-config-entry__technical"><summary>{{localize "RTA.Template.Technical"}}</summary><label>{{localize "RTA.Template.Id"}}<input data-field-prop="id" value="{{id}}" readonly></label></details>
                  </div>
                </details>
              </article>
            {{else}}<p class="rta-config-entry__empty">{{localize "RTA.Template.NoDirectFieldsYetAddOneOrUseFieldsInjectedBySelectedCapabilities"}}</p>{{/each}}
          </div>
        </details>

        <details class="rta-config-entry__section"><summary>{{localize "RTA.Template.Constraints"}}</summary>
          <p class="hint">{{localize "RTA.Declarative.HelpConstraints"}}</p>
          <select data-constraint-field-options hidden aria-hidden="true">{{#each constraintFieldOptions}}<option value="{{id}}" data-rta-colors="{{colors}}">{{id}}</option>{{/each}}</select>
          <div data-declarative-constraints>{{#each constraintRows}}
            <div class="rta-declarative-constraint" data-declarative-constraint>
              <label>{{localize "RTA.Declarative.Field"}}<select data-constraint-field {{#if ../readOnly}}disabled{{/if}}>{{#each fields}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{id}}</option>{{/each}}</select></label>
              <label>{{localize "RTA.Declarative.Rule"}}<select data-constraint-kind {{#if ../readOnly}}disabled{{/if}}>{{#each kinds}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{id}}</option>{{/each}}</select></label>
              <label>{{localize "RTA.Declarative.Value"}}<input data-constraint-value value="{{value}}" {{#if ../readOnly}}readonly{{/if}}></label>
              {{#unless ../readOnly}}<button type="button" data-action="removeDeclarativeConstraint" aria-label="{{localize 'RTA.Declarative.DeleteConstraint'}}"><i class="fa-solid fa-trash"></i></button>{{/unless}}
            </div>{{/each}}</div>
          {{#unless readOnly}}<button type="button" data-action="addDeclarativeConstraint"><i class="fa-solid fa-plus"></i> {{localize "RTA.Declarative.AddConstraint"}}</button>{{/unless}}
          <details class="rta-config-entry__technical"><summary>{{localize "RTA.Declarative.HistoricalRules"}}</summary><textarea name="constraintsJson" rows="4" readonly>{{constraintsJson}}</textarea></details>
        </details>
        <details class="rta-config-entry__section"><summary>{{localize "RTA.Template.Presentation"}}</summary>{{> rtaPresentationEditor}}<details class="rta-config-entry__technical"><summary>{{localize "RTA.Declarative.HistoricalPresentation"}}</summary><textarea name="presentationJson" rows="4" readonly>{{presentationJson}}</textarea></details></details>
        <details class="rta-config-entry__section rta-config-entry__technical"><summary>{{localize "RTA.Template.Technical"}}</summary><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Id"}}</label><input value="{{data.id}}" readonly></div><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Key"}}</label><input value="{{data.key}}" readonly></div><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Order"}}</label><input value="{{data.order}}" readonly></div></details>
      {{/if}}

      {{#if isDefinition}}
        <fieldset><legend>{{localize "RTA.Template.Definition"}}</legend>
          {{> rtaIdentityName}}
          {{> rtaIdentityDescription}}
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.DefinitionType"}}</label><input value="{{type.nameKey}}" readonly></div>
          {{> rtaEnabled}}
          {{#each fieldContract}}
            <div class="form-group rta-definition-field" data-definition-field="{{id}}" data-value-type="{{valueType}}" data-cardinality="{{cardinality}}" data-nullable="{{nullable}}" data-required="{{required}}">
              <label>{{label}}</label>
              {{#if isBoolean}}<select data-field-value {{#if ../readOnly}}disabled{{/if}}><option value="">—</option><option value="true" {{#if trueSelected}}selected{{/if}}>{{localize "RTA.Template.Yes"}}</option><option value="false" {{#if falseSelected}}selected{{/if}}>{{localize "RTA.Template.No"}}</option>{{#if nullable}}<option value="null" {{#if nullSelected}}selected{{/if}}>{{localize "RTA.Template.Null"}}</option>{{/if}}</select>{{/if}}
              {{#if isNumber}}<input type="number" step="{{numberStep}}" min="{{numberMin}}" max="{{numberMax}}" data-field-value value="{{valueText}}" {{#if ../readOnly}}readonly{{/if}}>{{/if}}
              {{#if isText}}<input type="text" data-field-value value="{{valueText}}" {{#if ../readOnly}}readonly{{/if}}>{{/if}}
              {{#if isReference}}<select data-field-value {{#if ../readOnly}}disabled{{/if}}><option value="">{{localize "RTA.Template.Select"}}</option>{{#each referenceChoices}}<option value="{{token}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
              {{#if isReferenceMany}}<select data-field-value multiple {{#if ../readOnly}}disabled{{/if}}>{{#each referenceChoices}}<option value="{{token}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}{{#if isMany}}<textarea rows="2" data-field-value {{#if ../readOnly}}readonly{{/if}}>{{valueText}}</textarea>{{/if}}
            </div>
          {{/each}}
        </fieldset>
        <details class="rta-config-entry__section" open><summary>{{localize "RTA.Template.Capabilities"}}</summary>
          {{#if hasForcedCapabilities}}<div class="rta-config-entry__fixed-capabilities"><strong>{{localize "RTA.UI.RequiredCapabilities"}}</strong><div class="rta-config-entry__fixed-capabilities-list">{{#each capabilityChoices}}{{#if forced}}{{#if permitted}}<label class="rta-config-entry__fixed-capability"><input type="checkbox" name="cap:{{id}}" checked disabled> <span>{{id}} <small>({{category}})</small></span></label>{{/if}}{{/if}}{{/each}}</div></div>{{/if}}
          {{#if hasOptionalCapabilities}}<div class="rta-config-entry__check-group rta-choice-list" data-rta-select-label="{{localize 'RTA.UI.OptionalCapabilities'}}">{{#each capabilityChoices}}{{#if permitted}}{{#unless forced}}<label><input type="checkbox" name="cap:{{id}}" {{#if selected}}checked{{/if}} {{#if ../readOnly}}disabled{{/if}}> {{id}} <small>({{category}})</small></label>{{/unless}}{{/if}}{{/each}}</div>{{else}}<p class="rta-config-entry__empty">{{localize "RTA.UI.NoOptionalCapabilities"}}</p>{{/if}}
        </details>
        <details class="rta-config-entry__section"><summary>{{localize "RTA.Template.Classification"}}</summary><div class="rta-config-entry__full-width"><label>{{localize "RTA.Template.Categories"}}</label><textarea name="categories" rows="4" {{#if readOnly}}readonly{{/if}}>{{categoriesText}}</textarea></div></details>
        <details class="rta-config-entry__section"><summary>{{localize "RTA.Template.Presentation"}}</summary>{{> rtaPresentationEditor}}<details class="rta-config-entry__technical"><summary>{{localize "RTA.Declarative.HistoricalPresentation"}}</summary><textarea name="profileJson" rows="4" readonly>{{profileJson}}</textarea></details></details>
        <details class="rta-config-entry__section rta-config-entry__technical"><summary>{{localize "RTA.Template.AdvancedTechnical"}}</summary><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Id"}}</label><input value="{{data.id}}" readonly></div><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Key"}}</label><input value="{{data.key}}" readonly></div><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Order"}}</label><input value="{{data.order}}" readonly></div><details><summary>{{localize "RTA.Template.RawDataJson"}}</summary><textarea rows="8" readonly>{{dataJson}}</textarea></details></details>
      
        {{> rtaTagsPicker}}
      {{/if}}

      {{#if isTag}}
        <fieldset><legend>{{localize "RTA.Template.Tag"}}</legend>
          {{> rtaIdentityName}}
          {{> rtaIdentityDescription}}
          <div data-color-override-editor>
            <div class="form-group rta-form-row"><label>{{localize "RTA.Colors.SubsectionColor"}}</label><span class="rta-color-override-control">{{#if allowTypeColor}}<input type="hidden" name="customColorPermission" value="1"><label class="rta-color-override-check"><input data-color-override-toggle type="checkbox" name="customColorEnabled" {{#if hasCustomColor}}checked{{/if}} {{#if readOnly}}disabled{{/if}}> {{localize "RTA.Colors.UseCustomColor"}}</label>{{/if}}<input data-custom-color-input name="color" type="color" value="{{#if data.color}}{{data.color}}{{else}}{{inheritedTypeColor}}{{/if}}" {{#unless allowTypeColor}}disabled{{else}}{{#unless hasCustomColor}}disabled{{/unless}}{{/unless}} {{#if readOnly}}disabled{{/if}}></span></div>
          </div>
          {{> rtaEnabled}}
          <details class="rta-config-entry__technical"><summary>{{localize "RTA.Template.Technical"}}</summary><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Id"}}</label><input value="{{data.id}}" readonly></div></details>
        </fieldset>
      {{/if}}

      {{#if isReference}}
        <fieldset><legend>{{localize "RTA.Template.Reference"}}</legend>
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.Target"}}</label><select name="referenceTarget" required>{{#each referenceChoices}}<option value="{{token}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        </fieldset>
      {{/if}}


      {{#if isParameter}}
        <fieldset><legend>{{localize "RTA.Template.Parameter"}}</legend>
          {{> rtaIdentityName}}
          {{> rtaIdentityDescription}}
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.ValueType"}}</label><select name="valueType">{{#each valueTypes}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{id}}</option>{{/each}}</select></div>
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.Value"}}</label><input name="value" value="{{data.value}}"></div>
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.Nullable"}}</label><input name="nullable" type="checkbox" {{#if data.nullable}}checked{{/if}}></div>
          {{> rtaEnabled}}
          
        </fieldset>
        {{> rtaTagsPicker}}
      {{/if}}

      {{#if isFormula}}
        <fieldset><legend>{{localize "RTA.Template.Formula"}}</legend>
          {{> rtaIdentityName}}
          {{> rtaIdentityDescription}}
          <div class="form-group rta-form-row"><label>{{localize "RTA.Template.ResultType"}}</label><select name="resultType">{{#each valueTypes}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{id}}</option>{{/each}}</select></div>
          {{> rtaEnabled}}
          <section class="rta-rule-builder" data-formula-builder data-supported="{{formulaModel.supported}}">
            <div class="rta-rule-builder__heading"><strong>{{localize "RTA.Template.Expression"}}</strong>{{#if formulaModel.supported}}{{else}}<span>{{localize "RTA.Template.AdvancedAstReadOnlyInTheVisualBuilder"}}</span>{{/if}}</div>
            {{#if formulaModel.supported}}
