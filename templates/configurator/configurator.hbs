<section class="rta-configurator">
  {{#if error}}<p class="rta-configurator__error" role="alert">{{error}}</p>{{/if}}

  {{#if isRulesets}}
    <header class="rta-configurator__root-header">
      <div><h2>{{localize "RTA.Template.RuleThemAll"}}</h2><p>{{localize "RTA.UI.RulesetsSubtitle"}}</p></div>
      <div class="rta-display-switch" role="group" aria-label="{{localize 'RTA.UI.DisplayMode'}}"><button type="button" data-action="setDisplayMode" data-mode="tiles" class="{{#if displayTiles}}is-active{{/if}}" aria-pressed="{{#if displayTiles}}true{{else}}false{{/if}}" aria-label="{{localize 'RTA.UI.Tiles'}}" title="{{localize 'RTA.UI.Tiles'}}"><i class="fa-solid fa-grip"></i></button><button type="button" data-action="setDisplayMode" data-mode="lines" class="{{#if displayLines}}is-active{{/if}}" aria-pressed="{{#if displayLines}}true{{else}}false{{/if}}" aria-label="{{localize 'RTA.UI.Lines'}}" title="{{localize 'RTA.UI.Lines'}}"><i class="fa-solid fa-list"></i></button></div>
      <button type="button" data-action="addRuleset"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "RTA.UI.NewRuleset"}}</button>
    </header>
    <div data-main-scroll class="rta-configurator__scroll rta-ruleset-list-scroll">
      <div class="rta-ruleset-tiles{{#if displayLines}} rta-display-lines{{/if}}" role="list">
        {{#each rulesets}}
          <article class="rta-ruleset-tile" role="listitem" style="--rta-card-accent:{{color}}">
            <button type="button" class="rta-ruleset-tile__title" data-action="openWorkspace" data-version-id="{{versionId}}" title="{{localize 'RTA.Template.OpenRuleset'}}">{{name}}</button>
            <div class="rta-ruleset-tile__bottom">
              <div class="rta-ruleset-tile__badges"><span class="rta-ruleset-badge rta-ruleset-badge--status">{{statusLabel}}</span><span class="rta-ruleset-badge rta-ruleset-badge--version"><i class="fa-solid fa-code-branch" aria-hidden="true"></i> {{version}}</span>{{#if isActive}}<span class="rta-ruleset-badge rta-ruleset-badge--active">{{localize "RTA.Template.Active"}}</span>{{/if}}</div>
              <div class="rta-config-actions rta-ruleset-tile__actions">
                {{#if canCreateVersion}}<button class="rta-config-action" type="button" data-action="createNewVersion" data-version-id="{{versionId}}" data-tooltip="{{localize 'RTA.Template.CreateNewVersion'}}"><i class="fa-solid fa-code-branch"></i></button>{{/if}}
                {{#if isActive}}<button class="rta-config-action" type="button" data-action="deactivate" data-tooltip="{{localize 'RTA.Template.Deactivate'}}"><i class="fa-solid fa-pause"></i></button>{{else}}{{#if canActivate}}<button class="rta-config-action" type="button" data-action="activate" data-version-id="{{versionId}}" data-tooltip="{{localize 'RTA.Template.Activate'}}"><i class="fa-solid fa-play"></i></button>{{/if}}{{/if}}
                <button class="rta-config-action" type="button" data-action="export" data-version-id="{{versionId}}" data-tooltip="{{localize 'RTA.Template.Export'}}"><i class="fa-solid fa-download"></i></button>
                <button class="rta-config-action rta-config-action--danger" type="button" data-action="deleteRuleset" data-version-id="{{versionId}}" data-tooltip="{{localize 'RTA.Template.DeleteVersion'}}"><i class="fa-solid fa-trash"></i></button>
              </div>
            </div>
          </article>
        {{else}}<p>{{localize "RTA.Template.NoRulesetCreateOneToStartWithAnEmptyConfiguration"}}</p>{{/each}}
      </div>
    </div>
    <div class="rta-configurator__bottom-bar"><fieldset class="rta-configurator__import-footer"><legend>{{localize "RTA.UI.Import"}}</legend><div class="form-group"><input data-import-file type="file" accept=".json,application/json"></div></fieldset>
    <footer class="rta-configurator__root-footer"><button type="button" data-action="closeConfigurator">{{localize "RTA.UI.Close"}}</button></footer></div>
  {{else}}
    <header class="rta-configurator__workspace-header">
      <button type="button" data-action="backToRulesets"><i class="fa-solid fa-arrow-left"></i> {{localize "RTA.Template.Rulesets"}}</button>
      <div><strong>{{selectedRulesetName}}</strong><span>v{{selectedRuleset.version}} · {{lifecycle.statusLabel}}</span></div>
      <div class="rta-config-actions"></div>
    </header>
    <div class="rta-configurator__workspace">
      <nav class="rta-explorer" style="--rta-card-accent:{{rulesetAccent}}" aria-label="{{localize 'RTA.Template.RuleThemAllNavigation'}}" data-explorer>
        <div class="rta-explorer__groups">
          {{#each navGroups}}
            <button type="button" style="--rta-card-accent:{{color}};--rta-nav-accent:{{color}}" data-action="navGroup" data-group="{{id}}" data-nav-group class="rta-explorer__group{{#if active}} is-active{{/if}}" aria-expanded="false"><i class="fa-solid {{icon}} rta-explorer__icon--{{id}}"></i><span>{{title}}</span><i class="fa-solid fa-chevron-right rta-explorer__chevron"></i></button>
          {{/each}}
        </div>
        <div class="rta-explorer__flyout" data-nav-panel hidden>
          <div class="rta-explorer__flyout-heading"><strong data-flyout-title></strong><button type="button" data-nav-dismiss aria-label="{{localize 'RTA.Template.Close'}}"><i class="fa-solid fa-xmark"></i></button></div>
          <div class="rta-explorer__flyout-list">
            {{#each navGroups}}
              <section data-flyout-group="{{id}}" hidden>
                {{#each items}}
                  <button type="button" style="--rta-card-accent:{{color}};--rta-nav-accent:{{color}}" data-action="navigate" data-view="{{view}}" data-nav-item class="rta-explorer__item{{#if primary}} rta-explorer__item--primary{{/if}}{{#if active}} is-active{{/if}}" {{#if active}}aria-current="page"{{/if}}><span>{{title}}</span>{{#if primary}}<i class="fa-solid fa-sliders rta-explorer__primary-icon" aria-hidden="true"></i>{{/if}}</button>
                {{/each}}
              </section>
            {{/each}}
          </div>
        </div>
      </nav>
      <main data-main-scroll class="rta-configurator__scroll rta-configurator__workspace-content">
        {{#if isGeneral}}
          <section class="rta-general" style="--rta-card-accent:{{rulesetAccent}}" aria-label="{{localize 'RTA.Template.General'}}">
            <header class="rta-general__header">
              <div><h2>{{selectedRulesetName}}</h2></div>
              <div class="rta-general__header-actions"><button type="button" data-action="editRuleset" {{#unless canEditRuleset}}disabled title="{{localize 'RTA.Colors.ReadOnly'}}"{{/unless}}><i class="fa-solid fa-pen" aria-hidden="true"></i> {{localize "RTA.Colors.EditRuleset"}}</button></div>
            </header>
            <div class="rta-general__cards">
              <section class="rta-general__card"><h3><i class="fa-solid fa-sliders" aria-hidden="true"></i> {{localize "RTA.Template.VersionAndStatus"}}</h3>
                <dl><dt>{{localize "RTA.Template.Version"}}</dt><dd>{{selectedRuleset.version}}</dd><dt>{{localize "RTA.Template.Status"}}</dt><dd>{{lifecycle.statusLabel}}{{#if lifecycle.isActive}} · {{localize "RTA.Template.Active"}}{{/if}}</dd></dl>
                <div class="rta-general__lifecycle-actions rta-config-actions">
                  {{#if lifecycle.canMutate}}<button type="button" data-action="publish"><i class="fa-solid fa-upload" aria-hidden="true"></i> {{localize "RTA.Template.Publish"}}</button>{{/if}}
                  {{#if lifecycle.isReady}}<button type="button" data-action="validate"><i class="fa-solid fa-check-double" aria-hidden="true"></i> {{localize "RTA.Template.ValidateVersion"}}</button>{{/if}}
                  {{#if lifecycle.isActive}}<button type="button" data-action="deactivate"><i class="fa-solid fa-pause" aria-hidden="true"></i> {{localize "RTA.Template.Deactivate"}}</button>{{else}}{{#if lifecycle.canActivate}}<button type="button" data-action="activate"><i class="fa-solid fa-play" aria-hidden="true"></i> {{localize "RTA.Template.Activate"}}</button>{{/if}}{{/if}}
                  {{#if lifecycle.canCreateVersion}}<button type="button" data-action="createNewVersion"><i class="fa-solid fa-code-branch" aria-hidden="true"></i> {{localize "RTA.Template.CreateNewVersion"}}</button>{{/if}}
                </div>
              </section>
            </div>
            {{#if publishReadiness}}<section class="rta-general__card rta-general__readiness"><h3><i class="fa-solid fa-list-check" aria-hidden="true"></i> {{localize "RTA.Template.PublishReadiness"}}</h3>{{#if publishReadiness.ready}}<p>{{localize "RTA.Template.PublishReady"}}</p>{{else}}<p>{{localize "RTA.Template.PublishMissing"}} ({{publishReadiness.count}})</p><ul class="rta-general__readiness-list">{{#each publishReadiness.items}}<li>{{#if kind}}<button type="button" class="rta-general__readiness-link" data-action="openDiagnostic" data-kind="{{kind}}" data-entry-id="{{entryId}}" data-path="{{path}}" data-tooltip="{{localize "RTA.Template.PublishFix"}}"><strong>{{objectLabel}}</strong> {{message}}<i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></button>{{else}}<strong>{{objectLabel}}</strong> {{message}}{{/if}}</li>{{/each}}</ul>{{/if}}</section>{{/if}}
            {{#if recipes}}<details class="rta-general__card rta-general__recipes"><summary><i class="fa-solid fa-book" aria-hidden="true"></i> {{localize "RTA.Recipe.Title"}}</summary><p class="hint">{{#if lifecycle.canMutate}}{{localize "RTA.Recipe.Intro"}}{{else}}{{localize "RTA.Recipe.ReadOnly"}}{{/if}}</p><div class="rta-general__recipe-list">{{#each recipes}}<article class="rta-general__recipe"><h4>{{localize titleKey}}</h4><p>{{localize summaryKey}}</p><ol>{{#each steps}}<li>{{localize this}}</li>{{/each}}</ol>{{#if ../lifecycle.canMutate}}<button type="button" data-action="applyRecipe" data-recipe-id="{{id}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "RTA.Recipe.Apply"}}</button>{{/if}}</article>{{/each}}</div></details>{{/if}}
            <details class="rta-configurator__storage rta-general__storage"><summary><i class="fa-solid fa-database" aria-hidden="true"></i> {{localize "RTA.Template.Technical"}}</summary><dl><dt>{{localize "RTA.Template.Id"}}</dt><dd>{{selectedRuleset.id}}</dd><dt>versionId</dt><dd>{{selectedRecord.versionId}}</dd><dt>storageRevision</dt><dd>{{storage.storageRevision}}</dd><dt>engineContractVersion</dt><dd>{{storage.engineContractVersion}}</dd></dl></details>
          </section>
        {{/if}}

        {{#if isCollection}}
          <div class="rta-configurator__section-heading"><div><h2>{{currentTitle}}</h2>{{#if currentType}}{{#if isContentFamily}}<p>{{localize "RTA.Template.FoundryBackedContentsOfThisConfigurableType"}}</p>{{else}}<p>{{localize "RTA.Template.DefinitionsOfThisConfigurableType"}}</p>{{/if}}{{else}}<p>{{localize "RTA.Template.ConfigurableRuleThemAllEntries"}}</p>{{/if}}</div>
            <div class="rta-configurator__section-actions">{{#if canOverrideCollection}}<div class="rta-collection-color-editor" title="{{localize 'RTA.Colors.CollectionOverride'}}"><label for="rta-collection-color">{{localize "RTA.Colors.SubsectionColor"}}</label><input id="rta-collection-color" type="color" data-collection-color="{{currentCollection}}" value="{{collectionAccent}}" aria-label="{{localize 'RTA.Colors.SubsectionColor'}}"><button type="button" data-action="resetCollectionColor" data-collection="{{currentCollection}}" {{#unless collectionCustomAccent}}disabled{{/unless}} title="{{localize 'RTA.Colors.ResetInheritance'}}"><i class="fa-solid fa-arrow-rotate-left"></i></button></div>{{/if}}<div class="rta-display-switch" role="group" aria-label="{{localize 'RTA.UI.DisplayMode'}}"><button type="button" data-action="setDisplayMode" data-mode="tiles" class="{{#if displayTiles}}is-active{{/if}}" aria-pressed="{{#if displayTiles}}true{{else}}false{{/if}}" aria-label="{{localize 'RTA.UI.Tiles'}}" title="{{localize 'RTA.UI.Tiles'}}"><i class="fa-solid fa-grip"></i></button><button type="button" data-action="setDisplayMode" data-mode="lines" class="{{#if displayLines}}is-active{{/if}}" aria-pressed="{{#if displayLines}}true{{else}}false{{/if}}" aria-label="{{localize 'RTA.UI.Lines'}}" title="{{localize 'RTA.UI.Lines'}}"><i class="fa-solid fa-list"></i></button></div>{{#if isContentLibraries}}<button type="button" data-action="syncContentLibraries"><i class="fa-solid fa-box-archive"></i> {{localize "RTA.Template.SyncFoundryLibraries"}}</button>{{/if}}{{#if lifecycle.canMutate}}<button type="button" data-action="addEntry" data-kind="{{currentKind}}" {{#if currentType}}{{#if isContentFamily}}data-content-type-id="{{currentType.id}}"{{else}}data-definition-type-id="{{currentType.id}}"{{/if}}{{/if}}><i class="fa-solid fa-plus"></i> {{localize "RTA.Template.Create"}}</button>{{else}}<button type="button" data-action="createNewVersion"><i class="fa-solid fa-code-branch"></i> {{localize "RTA.Template.CreateNewVersion"}}</button>{{/if}}</div>
          </div>
          {{#if availableTags.length}}
          <nav class="rta-tag-facets" aria-label="{{localize 'RTA.UI.FilterByTags'}}">
            <span class="rta-tag-facets__label"><i class="fa-solid fa-filter" aria-hidden="true"></i> {{localize "RTA.UI.FilterByTags"}}</span>
            {{#each availableTags}}<button type="button" class="rta-tag-facets__chip{{#if selected}} is-active{{/if}}" data-action="toggleTagFilter" data-tag-id="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" {{#if color}}style="--rta-tag-color:{{color}}"{{/if}}><span>{{name}}</span><small>{{count}}</small></button>{{/each}}
            {{#if activeTagCount}}<button type="button" class="rta-tag-facets__clear" data-action="clearTagFilters"><i class="fa-solid fa-xmark" aria-hidden="true"></i> {{localize "RTA.UI.ClearTagFilters"}}</button>{{/if}}
          </nav>
          {{/if}}
          {{#if availableCategories.length}}
          <nav class="rta-tag-facets" aria-label="{{localize 'RTA.UI.FilterByCategories'}}">
            <span class="rta-tag-facets__label"><i class="fa-solid fa-folder-tree" aria-hidden="true"></i> {{localize "RTA.UI.FilterByCategories"}}</span>
            {{#each availableCategories}}<button type="button" class="rta-tag-facets__chip{{#if selected}} is-active{{/if}}" data-action="toggleCategoryFilter" data-category-id="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><span>{{name}}</span><small>{{count}}</small></button>{{/each}}
            {{#if activeCategoryCount}}<button type="button" class="rta-tag-facets__clear" data-action="clearCategoryFilters"><i class="fa-solid fa-xmark" aria-hidden="true"></i> {{localize "RTA.UI.ClearCategoryFilters"}}</button>{{/if}}
          </nav>
          {{/if}}
          <div class="rta-config-card-grid{{#if displayLines}} rta-display-lines{{/if}}" role="list" data-card-grid>
            {{#each cards}}
              <article class="rta-config-card{{#unless enabled}} rta-config-card--disabled{{/unless}}" style="--rta-card-accent: {{cardColor}}" role="listitem" draggable="{{#if ../canReorder}}true{{else}}false{{/if}}" data-orderable-card data-kind="{{../currentKind}}" data-entry-id="{{id}}">
                <button class="rta-config-card__title" type="button" data-action="openEntry" data-kind="{{../currentKind}}" data-entry-id="{{id}}">{{name}}</button>
                <div class="rta-config-card__bottom">
                  <div class="rta-config-card__tags">{{#each displayTags}}<span class="rta-config-card__tag" {{#if color}}style="--rta-tag-color: {{color}}"{{/if}} title="{{name}}">{{name}}</span>{{/each}}</div>
                  <button class="rta-config-action rta-config-card__edit" type="button" data-action="openEntry" data-kind="{{../currentKind}}" data-entry-id="{{id}}" aria-label="{{localize 'RTA.UI.Edit'}}" title="{{localize 'RTA.UI.Edit'}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
                </div>
              </article>
            {{else}}<p>{{localize "RTA.Template.NoEntries"}}</p>{{/each}}
          </div>
        {{/if}}


        {{#if isRuntimeLab}}
          <div class="rta-configurator__section-heading"><div><h2>{{localize "RTA.Template.RuntimeLab"}}</h2><p>{{localize "RTA.Template.GuidedSandboxPrepareActorsSetValuesChooseOneRuleRunItReadTheResult"}}</p></div></div>
          <section class="rta-runtime-lab rta-runtime-lab--guided">
            <section class="rta-lab-step">
              <header><span class="rta-lab-step__number">1</span><div><h3>{{localize "RTA.Template.PrepareTheTestActors"}}</h3><p>{{localize "RTA.Template.UseTheTwoDedicatedActorsOrSelectExistingActorsThenInitializeTheirRuntimeData"}}</p></div></header>
              <div class="rta-runtime-lab__grid">
                <div class="form-group rta-form-row"><label>{{localize "RTA.Template.SourceSelf"}}</label><select data-runtime-select="source"><option value="">{{#if actors.length}}{{localize "RTA.Lab.ChooseActor"}}{{else}}{{localize "RTA.Template.NoActorsInThisWorld"}}{{/if}}</option>{{#each actors}}<option value="{{uuid}}" {{#if selectedSource}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
                <div class="form-group rta-form-row"><label>{{localize "RTA.Template.Target"}}</label><select data-runtime-select="target"><option value="">{{#if actors.length}}{{localize "RTA.Lab.ChooseActor"}}{{else}}{{localize "RTA.Template.NoActorsInThisWorld"}}{{/if}}</option>{{#each actors}}<option value="{{uuid}}" {{#if selectedTarget}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
              </div>
              <div class="rta-runtime-lab__grid">
                <div class="form-group rta-form-row"><label>{{localize "RTA.DocumentSubtype.Source"}}</label><select data-runtime-select="sourceType"><option value="">{{localize "RTA.DocumentSubtype.Choose"}}</option>{{#each runtimeActorTypeOptions}}<option value="{{id}}" {{#if sourceSelected}}selected{{/if}}>{{id}}</option>{{/each}}</select></div>
                <div class="form-group rta-form-row"><label>{{localize "RTA.DocumentSubtype.Target"}}</label><select data-runtime-select="targetType"><option value="">{{localize "RTA.DocumentSubtype.Choose"}}</option>{{#each runtimeActorTypeOptions}}<option value="{{id}}" {{#if targetSelected}}selected{{/if}}>{{id}}</option>{{/each}}</select></div>
              </div>
              <div class="rta-runtime-lab__actions"><button type="button" data-action="runtimeCreateActors"><i class="fa-solid fa-user-plus"></i> {{localize "RTA.Template.CreateSelectTestActors"}}</button><button type="button" data-action="runtimeInitAll" {{#unless runtimeReady.actors}}disabled{{/unless}}><i class="fa-solid fa-layer-group"></i> {{localize "RTA.Template.InitializeBothActors"}}</button><button type="button" data-action="runtimeReset" data-tooltip="{{localize "RTA.Lab.ResetHint"}}" {{#unless runtimeReady.actors}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> {{localize "RTA.Lab.Reset"}}</button></div>
            </section>

            <section class="rta-lab-step">
              <header><span class="rta-lab-step__number">2</span><div><h3>{{localize "RTA.Template.SetTheValuesYouWantToTest"}}</h3><p>{{localize "RTA.Template.EditRuntimeValuesDirectlyNoTechnicalIdsAndNoManualInstantiationWorkflow"}}</p></div></header>
              <div class="form-group rta-form-row rta-lab-editing"><label>{{localize "RTA.Template.Editing"}}</label><select data-runtime-select="actorRole"><option value="source" {{#if runtimeModes.editSource}}selected{{/if}}>{{localize "RTA.Template.SourceSelf"}} · {{runtimeActorNames.source}}</option><option value="target" {{#if runtimeModes.editTarget}}selected{{/if}}>{{localize "RTA.Template.Target"}} · {{runtimeActorNames.target}}</option></select></div>
              <div class="rta-runtime-state-editor">
                {{#each runtimeStateCards}}
                  <div class="rta-runtime-state-row" data-runtime-state-row>
                    <strong>{{name}}</strong>
                    <div class="rta-runtime-state-row__values">
                      {{#if hasValue}}<label>{{localize "RTA.Template.Value"}} <input name="runtimeStateBase" type="number" value="{{base}}"></label>{{/if}}
                      {{#each pools}}<label>{{localize "RTA.Template.Current"}} · {{slotId}} <input name="runtimeStatePool" data-slot-id="{{slotId}}" type="number" value="{{current}}"></label>{{/each}}
                      {{#if hasState}}<label class="rta-runtime-state-row__check"><input name="runtimeStateActive" type="checkbox" {{#if active}}checked{{/if}}> {{localize "RTA.Template.Active2"}}</label>{{/if}}
                    </div>
                    <button type="button" data-action="runtimeUpdateState" data-definition-id="{{id}}">{{localize "RTA.Template.Save"}}</button>
                  </div>
                {{else}}<p class="hint">{{#if runtimeStateError}}{{runtimeStateError}}{{else}}{{localize "RTA.Template.NoRuntimeValuesYetCompleteStep1AndInitializeTheActors"}}{{/if}}</p>{{/each}}
              </div>
            </section>

            <section class="rta-lab-step">
              <header><span class="rta-lab-step__number">3</span><div><h3>{{localize "RTA.Template.ChooseWhatYouWantToTest"}}</h3><p>{{localize "RTA.Template.StartWithTestForNormalGameplayValidationTheOtherToolsAreDiagnostics"}}</p></div></header>
              <div class="rta-lab-tool-tabs">
                <label><input type="radio" name="runtimeTool" data-runtime-select="tool" value="test" {{#if runtimeModes.isTest}}checked{{/if}}> {{localize "RTA.Template.Test"}}</label>
                <label><input type="radio" name="runtimeTool" data-runtime-select="tool" value="action" {{#if runtimeModes.isAction}}checked{{/if}}> {{localize "RTA.Template.Action"}}</label>
                <label><input type="radio" name="runtimeTool" data-runtime-select="tool" value="formula" {{#if runtimeModes.isFormula}}checked{{/if}}> {{localize "RTA.Template.Formula"}}</label>
                <label><input type="radio" name="runtimeTool" data-runtime-select="tool" value="condition" {{#if runtimeModes.isCondition}}checked{{/if}}> {{localize "RTA.Template.Condition"}}</label>
                <label><input type="radio" name="runtimeTool" data-runtime-select="tool" value="event" {{#if runtimeModes.isEvent}}checked{{/if}}> {{localize "RTA.Template.Event"}}</label>
                <label><input type="radio" name="runtimeTool" data-runtime-select="tool" value="roll" {{#if runtimeModes.isRoll}}checked{{/if}}> {{localize "RTA.Template.DiceOnly"}}</label>
              </div>
              <p class="rta-lab-guide">{{runtimeGuide}}</p>
              {{#if runtimeModes.isTest}}<div class="rta-lab-run"><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Test"}}</label><select data-runtime-select="testId"><option value="">{{#if runtimeTests.length}}{{localize "RTA.Lab.Choose"}}{{else}}{{localize "RTA.Template.NoTest"}}{{/if}}</option>{{#each runtimeTests}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div><button type="button" data-action="runtimeTest" {{#unless runtimeReady.test}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i> {{localize "RTA.Template.RunTest"}}</button></div>{{/if}}
              {{#if runtimeModes.isAction}}<div class="rta-lab-run"><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Action"}}</label><select data-runtime-select="actionId"><option value="">{{#if runtimeActions.length}}{{localize "RTA.Lab.Choose"}}{{else}}{{localize "RTA.Template.NoAction"}}{{/if}}</option>{{#each runtimeActions}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div><button type="button" data-action="runtimePreviewAction" {{#unless runtimeReady.action}}disabled{{/unless}}>{{localize "RTA.Template.Preview"}}</button><button type="button" data-action="runtimeExecuteAction" {{#unless runtimeReady.action}}disabled{{/unless}}>{{localize "RTA.Template.Execute"}}</button></div>{{/if}}
              {{#if runtimeModes.isFormula}}<div class="rta-lab-run"><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Formula"}}</label><select data-runtime-select="formulaId"><option value="">{{#if runtimeFormulas.length}}{{localize "RTA.Lab.Choose"}}{{else}}{{localize "RTA.Template.NoFormula"}}{{/if}}</option>{{#each runtimeFormulas}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div><button type="button" data-action="runtimeFormula" {{#unless runtimeReady.formula}}disabled{{/unless}}>{{localize "RTA.Template.Evaluate"}}</button></div>{{/if}}
              {{#if runtimeModes.isCondition}}<div class="rta-lab-run"><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Condition"}}</label><select data-runtime-select="conditionId"><option value="">{{#if runtimeConditions.length}}{{localize "RTA.Lab.Choose"}}{{else}}{{localize "RTA.Template.NoCondition"}}{{/if}}</option>{{#each runtimeConditions}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div><button type="button" data-action="runtimeCondition" {{#unless runtimeReady.condition}}disabled{{/unless}}>{{localize "RTA.Template.Evaluate"}}</button></div>{{/if}}
              {{#if runtimeModes.isEvent}}<div class="rta-lab-run"><div class="form-group rta-form-row"><label>{{localize "RTA.Template.Event"}}</label><select data-runtime-select="eventTypeId"><option value="">{{#if runtimeEvents.length}}{{localize "RTA.Lab.Choose"}}{{else}}{{localize "RTA.Template.NoEventType"}}{{/if}}</option>{{#each runtimeEvents}}<option value="{{id}}" data-rta-colors="{{colors}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div><button type="button" data-action="runtimeEvent" {{#unless runtimeReady.event}}disabled{{/unless}}>{{localize "RTA.Template.EmitEvent"}}</button></div>{{/if}}
              {{#if runtimeModes.isRoll}}<div class="rta-lab-run"><div class="form-group rta-form-row"><label>{{localize "RTA.Lab.Dice"}}</label><input name="runtimeRollFormula" data-runtime-input="rollFormula" value="{{runtimeSelection.rollFormula}}" placeholder="1d20 + 2"></div><button type="button" data-action="runtimeRoll"><i class="fa-solid fa-dice-d20"></i> {{localize "RTA.Template.RollWithFoundry"}}</button></div>{{/if}}
            </section>

            <section class="rta-lab-step rta-lab-step--result">
              <header><span class="rta-lab-step__number">4</span><div><h3>{{localize "RTA.Template.ReadTheResult"}}</h3><p>{{localize "RTA.Template.TheLatestOperationIsSummarizedHereRunAnotherRuleToReplaceIt"}}</p></div></header>
              {{#if runtimeResult}}<section class="rta-runtime-result" data-tone="{{runtimeResult.tone}}" role="status">
                <h3>{{runtimeResult.title}}</h3>
                {{#if runtimeResult.message}}<p class="rta-runtime-result__message">{{runtimeResult.message}}</p>{{/if}}
                {{#if runtimeResult.rows.length}}<dl class="rta-runtime-result__rows">{{#each runtimeResult.rows}}<dt>{{label}}</dt><dd>{{value}}</dd>{{/each}}</dl>{{/if}}
                {{#if runtimeResult.changes.length}}<table class="rta-config-table"><thead><tr><th>{{localize "RTA.Template.Effect"}}</th><th>{{localize "RTA.Template.Before"}}</th><th>{{localize "RTA.Template.After"}}</th></tr></thead><tbody>{{#each runtimeResult.changes}}<tr><td>{{name}}</td><td>{{before}}</td><td>{{after}}</td></tr>{{/each}}</tbody></table>{{/if}}
                {{#if runtimeResult.triggered.length}}<ul class="rta-runtime-result__list">{{#each runtimeResult.triggered}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
              </section>{{else}}<p class="hint">{{localize "RTA.Template.NothingRunYet"}}</p>{{/if}}
            </section>
          </section>
        {{/if}}

        {{#if isDependencies}}
          <div class="rta-configurator__section-heading"><div><h2>{{localize "RTA.Dependencies.Title"}}</h2><p>{{localize "RTA.Dependencies.Subtitle"}}</p></div></div>
          <div class="rta-dependencies__stats"><span>{{dependencyStats.consumers}} {{localize "RTA.Dependencies.Consumers"}}</span><span>{{dependencyStats.relations}} {{localize "RTA.Dependencies.Relations"}}</span>{{#if dependencyStats.unresolved}}<button type="button" class="rta-dependencies__warning{{#if dependencyUnresolvedOnly}} is-active{{/if}}" data-action="toggleDependencyUnresolved" aria-pressed="{{#if dependencyUnresolvedOnly}}true{{else}}false{{/if}}" title="{{localize 'RTA.Dependencies.FilterUnresolved'}}">{{dependencyStats.unresolved}} {{localize "RTA.Dependencies.Unresolved"}} <i class="fa-solid fa-filter" aria-hidden="true"></i></button>{{/if}}</div>
          {{#if dependencyAvailableTags.length}}
          <nav class="rta-tag-facets" aria-label="{{localize 'RTA.UI.FilterByTags'}}">
            <span class="rta-tag-facets__label"><i class="fa-solid fa-filter" aria-hidden="true"></i> {{localize "RTA.UI.FilterByTags"}}</span>
            {{#each dependencyAvailableTags}}<button type="button" class="rta-tag-facets__chip{{#if selected}} is-active{{/if}}" data-action="toggleTagFilter" data-tag-id="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" {{#if color}}style="--rta-tag-color:{{color}}"{{/if}}><span>{{name}}</span><small>{{count}}</small></button>{{/each}}
            {{#if dependencyActiveTagCount}}<button type="button" class="rta-tag-facets__clear" data-action="clearTagFilters"><i class="fa-solid fa-xmark" aria-hidden="true"></i> {{localize "RTA.UI.ClearTagFilters"}}</button>{{/if}}
          </nav>
          {{/if}}
          <div class="rta-dependencies">
            <aside class="rta-dependencies__list" aria-label="{{localize 'RTA.Dependencies.Consumers'}}">
              <label class="rta-dependencies__search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-dependency-search placeholder="{{localize 'RTA.Dependencies.Search'}}"></label>
              <div class="rta-dependencies__items">{{#each dependencyGroups}}
                <div class="rta-dependencies__row{{#if selected}} is-active{{/if}}" data-dependency-item data-search="{{name}} {{type}} {{id}}" style="--rta-card-accent:{{cardColor}}">
                  <button type="button" class="rta-dependencies__item" data-action="selectDependency" data-dependency-key="{{key}}" title="{{name}}"><span class="rta-dependencies__item-name">{{name}}</span><small>{{type}} · {{targetCount}} {{localize 'RTA.Dependencies.Targets'}}</small></button>
                  {{#if found}}<button class="rta-config-action rta-config-card__edit" type="button" data-action="openEntry" data-kind="{{kind}}" data-entry-id="{{id}}" title="{{localize 'RTA.UI.Edit'}}" aria-label="{{localize 'RTA.UI.Edit'}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{/if}}
                </div>
              {{else}}<p class="hint">{{localize "RTA.Dependencies.Empty"}}</p>{{/each}}</div>
            </aside>
            <section class="rta-dependencies__detail" aria-label="{{localize 'RTA.Dependencies.Detail'}}">
              {{#if dependencySelected}}
                <header><div><h3>{{dependencySelected.name}}</h3><p>{{dependencySelected.type}}</p></div><span>{{dependencySelected.relationCount}} {{localize "RTA.Dependencies.Relations"}}</span></header>
                <div class="rta-dependencies__graph-tools"><span>{{dependencyGraph.incomingCount}} {{localize 'RTA.Dependencies.UsedBy'}} · {{dependencyGraph.outgoingCount}} {{localize 'RTA.Dependencies.DependsOn'}}</span><div><button type="button" data-graph-zoom-out title="{{localize 'RTA.Template.Zoom'}}">−</button><button type="button" data-graph-reset title="{{localize 'RTA.Template.Recentrer'}}"><i class="fa-solid fa-arrows-to-circle"></i></button><button type="button" data-graph-zoom-in title="{{localize 'RTA.Template.Zoom2'}}">+</button></div></div>
                <svg class="rta-dependencies__graph" data-dependency-graph viewBox="0 0 {{dependencyGraph.width}} {{dependencyGraph.height}}" role="img" aria-label="{{localize 'RTA.Dependencies.Graph'}}" xmlns="http://www.w3.org/2000/svg">
                  <defs><pattern id="rta-dep-dots" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1" fill="currentColor" opacity=".16"/></pattern></defs>
                  <rect width="100%" height="100%" fill="url(#rta-dep-dots)"/>
                  <g data-graph-viewport>
                    {{#each dependencyGraph.edges}}<path d="{{path}}" class="rta-dependencies__edge{{#if unresolved}} is-unresolved{{/if}}"><title>{{title}}</title></path>{{/each}}
                    {{#each dependencyGraph.nodes}}<g class="rta-dependencies__node{{#if center}} is-center{{/if}}{{#unless found}} is-unresolved{{/unless}}" transform="translate({{x}} {{y}})" {{#if selectable}}data-action="selectDependency" data-dependency-key="{{key}}" tabindex="0" role="button"{{/if}} {{#if found}}data-node-kind="{{kind}}" data-node-id="{{id}}"{{/if}} aria-label="{{name}}">
                      <rect width="155" height="58" rx="5"/><rect class="rta-dependencies__node-bar" width="155" height="17" rx="5"/><text class="rta-dependencies__node-type" x="8" y="12">{{type}}</text><text class="rta-dependencies__node-name" x="8" y="37">{{shortName}}</text><title>{{name}} ({{type}})</title>
                    </g>{{/each}}
                  </g>
                </svg>
                {{#if dependencyGraph.omitted}}<p class="hint">+ {{dependencyGraph.omitted}} {{localize 'RTA.Dependencies.MoreConnections'}}</p>{{/if}}
                <details class="rta-dependencies__technical"><summary>{{localize 'RTA.Dependencies.TechnicalDetails'}} ({{dependencySelected.relationCount}})</summary>
                  <div class="rta-dependencies__relations">{{#each dependencySelected.relations}}<details class="rta-dependencies__relation"><summary><span><strong>{{target.name}}</strong><small>{{target.type}}{{#unless target.found}} · {{localize 'RTA.Dependencies.Unresolved'}}{{/unless}}</small></span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary><dl><dt>{{localize "RTA.Dependencies.Relation"}}</dt><dd>{{kind}}</dd><dt>{{localize "RTA.Dependencies.Path"}}</dt><dd><code>{{path}}</code></dd><dt>{{localize "RTA.Template.Id"}}</dt><dd><code>{{target.id}}</code></dd></dl></details>{{/each}}</div>
                </details>
              {{else}}<p class="hint">{{localize "RTA.Dependencies.Empty"}}</p>{{/if}}
            </section>
          </div>
        {{/if}}
      </main>
    </div>
  {{/if}}
</section>
