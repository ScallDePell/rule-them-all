{
  "id": "rule-them-all",
  "type": "module",
  "title": "Rule Them'All",
  "description": "Generic Foundry VTT ruleset configurator, runtime rules engine, content bridge and declarative sheet builder.",
  "version": "0.1.66",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "socket": true,
  "esmodules": [
    "rule-them-all.mjs"
  ],
  "styles": [
    "styles/tokens.css",
    "styles/layout.css",
    "styles/explorer.css",
    "styles/rulesets.css",
    "styles/cards.css",
    "styles/general.css",
    "styles/dependencies.css",
    "styles/runtime-lab.css",
    "styles/sheet-builder.css",
    "styles/sheet.css",
    "styles/editor.css",
    "styles/choices.css",
    "styles/rule-builder.css",
    "styles/select.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    }
  ],
  "packs": []
}
